[
    {
        "type": "group",
        "label": "Background & Colors",
        "help": "Control the overall look of the section. Choose a color scheme and set a background using image or video."
    },
    {
        "key": "color_scheme",
        "label": "Color Scheme",
        "type": "color_scheme_selector"
    },
    {
        "key": "background_type",
        "label": "Background",
        "type": "radio",
        "options": [
            "none",
            "image",
            "video"
        ],
        "default": "none"
    },
    {
        "key": "background_image",
        "label": "Background Image",
        "type": "image",
        "conditional": {
            "field": "background_type",
            "value": "image"
        }
    },
    {
        "key": "background_video",
        "label": "Background Video",
        "type": "video",
        "conditional": {
            "field": "background_type",
            "value": "video"
        }
    },
    {
        "key": "background_attachment",
        "label": "Background Scroll",
        "type": "radio",
        "options": [
            "scroll",
            "fixed"
        ],
        "default": "scroll",
        "conditional": {
            "field": "background_type",
            "value": "image"
        }
    }
]
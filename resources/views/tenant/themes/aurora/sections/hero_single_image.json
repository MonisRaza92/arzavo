{
    "type": "image",
    "name": "Hero: Single Image",
    "icon": "fa-image",
    "order": 6,
    "category": "Hero",
    "color_scheme_id": 1,
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Appearance"
        },
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "container_width",
            "label": "Container Width",
            "type": "radio",
            "options": ["container", "full"],
            "default": "container"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Image"
        },
        {
            "key": "desktop_image",
            "label": "Desktop Image",
            "type": "image",
            "default": null
        },
        {
            "key": "mobile_image",
            "label": "Mobile Image",
            "type": "image",
            "default": null,
            "help": "Optional image for mobile devices"
        },
        {
            "key": "alt_text",
            "label": "Alt Text",
            "type": "text",
            "default": "",
            "placeholder": "Describe the image (SEO & accessibility)"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Link"
        },
        {
            "key": "image_link",
            "label": "Link URL",
            "type": "text",
            "default": ""
        },
        {
            "key": "open_new_tab",
            "label": "Open in New Tab",
            "type": "switch",
            "default": 0,
            "conditional": {
                "field": "image_link",
                "operator": "!=",
                "value": ""
            }
        },

        {
            "key": "group",
            "type": "group",
            "label": "Style"
        },
        {
            "key": "aspect_ratio",
            "label": "Aspect Radio",
            "type": "select",
            "default": "auto",
            "options": ["auto", "sqaure", "portrait", "landscape", "wide"]
        },
        {
            "key": "image_fit",
            "label": "Image Fit",
            "type": "radio",
            "options": ["cover", "contain"],
            "default": "auto",
            "conditional": {
                "field": "aspect_ratio",
                "operator": "!=",
                "value": "auto"
            }
        },
        {
            "key": "border_radius",
            "label": "Border Radius",
            "type": "radio",
            "default": "enable",
            "options": ["enable", "disable", "custom"]
        },
        {
            "key": "custom_border_radius",
            "label": "Border Radius (%)",
            "type": "range",
            "min": 0,
            "max": 50,
            "default": "0",
            "conditional": {
                "field": "border_radius",
                "operator": "==",
                "value": "custom"
            }
        },
        {
            "key": "opacity",
            "label": "Opacity (%)",
            "type": "range",
            "min": 10,
            "max": 100,
            "default": "100"
        },
        {
            "key": "lazy_load",
            "label": "Lazy Load",
            "type": "switch",
            "default": "1"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Spacing"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "margin_left",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "margin_right",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Responsive"
        },
        {
            "key": "hide_desktop",
            "label": "Hide on Desktop",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "hide_mobile",
            "label": "Hide on Mobile",
            "type": "switch",
            "default": "0"
        }
    ]
}

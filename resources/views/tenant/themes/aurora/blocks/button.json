{
    "type": "button",
    "name": "Button",
    "icon": "fa-arrow-pointer",
    "order": 3,
    "category": "Basic",
    "max_blocks": 0,
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Content"
        },
        {
            "key": "text",
            "label": "Button Text",
            "type": "text",
            "default": "Click Here",
            "placeholder": "Enter button text"
        },
        {
            "key": "url",
            "label": "Button URL",
            "type": "url",
            "default": "#",
            "placeholder": "https://example.com"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Type & Icon"
        },
        {
            "key": "button_type",
            "label": "Button Type",
            "type": "radio",
            "options": ["primary", "secondary"],
            "default": "primary"
        },
        {
            "key": "icon",
            "label": "Button Icon",
            "type": "icon",
            "default": "none"
        },
        {
            "key": "icon_position",
            "label": "Icon Position",
            "type": "radio",
            "options": ["left", "right"],
            "default": "right",
            "conditional": {
                "field": "icon",
                "value": "not:none"
            }
        },

        {
            "key": "group",
            "type": "group",
            "label": "Size & Width"
        },
        {
            "key": "width_desktop",
            "label": "Desktop Width",
            "type": "radio",
            "options": ["theme", "full"],
            "default": "theme"
        },
        {
            "key": "width_mobile",
            "label": "Mobile Width",
            "type": "radio",
            "options": ["theme", "full"],
            "default": "theme"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Text Alignment"
        },
        {
            "key": "text_align_desktop",
            "label": "Text Align (Desktop)",
            "type": "radio",
            "options": ["left", "center", "right"],
            "default": "center",
            "conditional": {
                "field": "width_desktop",
                "value": "full"
            }
        },
        {
            "key": "text_align_mobile",
            "label": "Text Align (Mobile)",
            "type": "radio",
            "options": ["left", "center", "right"],
            "default": "center",
            "conditional": {
                "field": "width_mobile",
                "value": "full"
            }
        },

        {
            "key": "group",
            "type": "group",
            "label": "Link Behavior"
        },
        {
            "key": "open_new_tab",
            "label": "Open in New Tab",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Spacing"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "margin_left",
            "label": "Margin Left",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "margin_right",
            "label": "Margin Right",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        }
    ]
}

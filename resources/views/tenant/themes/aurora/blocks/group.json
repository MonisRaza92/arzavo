{
    "type": "group",
    "name": "Group",
    "icon": "fa-layer-group",
    "order": 5,
    "category": "Layout",
    "color_scheme": null,
    "max_blocks": 5,
    "allowed_blocks": [
        "heading",
        "text",
        "image",
        "button",
        "divider",
        "logo",
        "group",
        "icon"
    ],
    "default_blocks": "",
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Color Scheme"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "radio",
            "options": [
                "parent",
                "saparate"
            ],
            "default": "parent"
        },
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector",
            "conditional": {
                "field": "color_scheme",
                "value": "saparate"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Background"
        },
        {
            "key": "background_type",
            "label": "Background Type",
            "type": "radio",
            "options": [
                "color",
                "media"
            ],
            "default": "color"
        },
        {
            "key": "media_type",
            "label": "Media Type",
            "type": "radio",
            "options": [
                "image",
                "video"
            ],
            "default": "image",
            "conditional": {
                "field": "background_type",
                "value": "media"
            }
        },
        {
            "key": "background_image",
            "label": "Background Image",
            "type": "image",
            "default": "",
            "conditional": [
                {
                    "field": "background_type",
                    "value": "media"
                },
                {
                    "field": "media_type",
                    "value": "image"
                }
            ]
        },
        {
            "key": "background_video",
            "label": "Background Video",
            "type": "video",
            "default": "",
            "conditional": [
                {
                    "field": "background_type",
                    "value": "media"
                },
                {
                    "field": "media_type",
                    "value": "video"
                }
            ]
        },
        {
            "key": "background_blur",
            "label": "Background Blur",
            "type": "switch",
            "default": "0",
            "text": "Enable blur effect on background",
            "conditional": {
                "field": "background_type",
                "value": "media"
            }
        },
        {
            "key": "background_blur_intensity",
            "label": "Blur Intensity",
            "type": "range",
            "default": "8",
            "min": 0,
            "max": 30,
            "conditional": {
                "field": "background_blur",
                "value": "1"
            }
        },
        {
            "key": "background_attachment",
            "label": "Background Scroll",
            "type": "radio",
            "options": [
                "scroll",
                "fixed"
            ],
            "default": "scroll",
            "conditional": {
                "field": "background_type",
                "value": "media"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Overlay",
            "conditional": {
                "field": "background_type",
                "value": "media"
            }
        },
        {
            "key": "background_overlay",
            "label": "Enable Overlay",
            "type": "switch",
            "default": "0",
            "text": "Overlay for media background",
            "conditional": {
                "field": "background_type",
                "value": "media"
            }
        },
        {
            "key": "overlay_color",
            "label": "Overlay Color",
            "type": "color",
            "default": "#000000",
            "conditional": [
                {
                    "field": "background_type",
                    "value": "media"
                },
                {
                    "field": "background_overlay",
                    "value": "1"
                }
            ]
        },
        {
            "key": "overlay_opacity",
            "label": "Overlay Opacity",
            "type": "range",
            "default": "50",
            "min": 0,
            "max": 100,
            "conditional": [
                {
                    "field": "background_type",
                    "value": "media"
                },
                {
                    "field": "background_overlay",
                    "value": "1"
                }
            ]
        },
        {
            "key": "group",
            "type": "group",
            "label": "Layout"
        },
        {
            "key": "direction",
            "label": "Direction",
            "type": "radio",
            "options": [
                "vertical",
                "horizontal"
            ],
            "default": "vertical"
        },
        {
            "key": "mobile_direction",
            "label": "Mobile Direction",
            "type": "switch",
            "default": "1",
            "text": "Vertical Direction in Mobile Screen",
            "conditional": {
                "field": "direction",
                "value": "horizontal"
            }
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": [
                "start",
                "center",
                "end"
            ],
            "default": "start"
        },
        {
            "key": "position",
            "label": "Content Position",
            "type": "select",
            "options": [
                "start",
                "center",
                "end",
                "between"
            ],
            "default": "center"
        },
        {
            "key": "gap",
            "label": "Gap Between Blocks",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "group",
            "type": "group",
            "label": "Positioning"
        },
        {
            "key": "block_position",
            "label": "Block Position",
            "type": "radio",
            "options": [
                "relative",
                "absolute"
            ],
            "default": "relative"
        },
        {
            "key": "top",
            "label": "Top Offset",
            "type": "number",
            "default": "0",
            "min": -200,
            "max": 200,
            "conditional": {
                "field": "block_position",
                "value": "absolute"
            }
        },
        {
            "key": "left",
            "label": "Left Offset",
            "type": "number",
            "default": "0",
            "min": -200,
            "max": 200,
            "conditional": {
                "field": "block_position",
                "value": "absolute"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Size & Width"
        },
        {
            "key": "width",
            "label": "Width",
            "type": "radio",
            "options": [
                "auto",
                "full",
                "custom"
            ],
            "default": "auto"
        },
        {
            "key": "max_width",
            "label": "Custom Width (%)",
            "type": "range",
            "default": "30",
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "width",
                "value": "custom"
            }
        },
        {
            "key": "width_mobile",
            "label": "Width (Mobile)",
            "type": "radio",
            "options": [
                "auto",
                "full",
                "custom"
            ],
            "default": "auto"
        },
        {
            "key": "max_width_mobile",
            "label": "Custom Width (%)",
            "type": "range",
            "default": "30",
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "width_mobile",
                "value": "custom"
            }
        },
        {
            "key": "custom_height",
            "label": "Custom Hieght (px)",
            "type": "range",
            "default": "30",
            "min": 0,
            "max": 800,
            "conditional": {
                "field": "block_position",
                "value": "absolute"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Border"
        },
        {
            "key": "border",
            "label": "Border",
            "type": "radio",
            "options": [
                "enable",
                "disable"
            ],
            "default": "disable"
        },
        {
            "key": "custom_border_width",
            "label": "Custom Border Width",
            "type": "switch",
            "default": "0",
            "conditional": {
                "field": "border",
                "value": "enable"
            }
        },
        {
            "key": "border_width",
            "label": "Border Width",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 10,
            "conditional": {
                "field": "custom_border_width",
                "value": "1"
            }
        },
        {
            "key": "custom_border_radius",
            "label": "Custom Border Radius",
            "type": "switch",
            "default": "0",
            "conditional": {
                "field": "border",
                "value": "enable"
            }
        },
        {
            "key": "border_radius",
            "label": "Border Radius",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "custom_border_radius",
                "value": "1"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Visibility"
        },
        {
            "key": "hide_desktop",
            "label": "Hide on Desktop",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "hide_mobile",
            "label": "Hide on Mobile",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "z_index",
            "label": "Z Index",
            "type": "number",
            "default": "1",
            "min": -10,
            "max": 100,
            "conditional": {
                "field": "block_position",
                "value": "absolute"
            }
        },
        {
            "key": "overflow",
            "label": "Overflow",
            "type": "radio",
            "options": [
                "visible",
                "hidden"
            ],
            "default": "visible"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Padding"
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_right",
            "label": "Padding Right",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_left",
            "label": "Padding Left",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        }
    ]
}
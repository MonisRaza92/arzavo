{
    "type": "social_links",
    "name": "Social Links",
    "icon": "fa-share-alt",
    "order": 9,
    "category": "Social",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "facebook_url",
            "label": "Facebook URL",
            "type": "text",
            "default": "",
            "placeholder": "https://facebook.com/yourpage"
        },
        {
            "key": "twitter_url",
            "label": "Twitter URL",
            "type": "text",
            "default": "",
            "placeholder": "https://twitter.com/youraccount"
        },
        {
            "key": "instagram_url",
            "label": "Instagram URL",
            "type": "text",
            "default": "",
            "placeholder": "https://instagram.com/youraccount"
        },
        {
            "key": "linkedin_url",
            "label": "LinkedIn URL",
            "type": "text",
            "default": "",
            "placeholder": "https://linkedin.com/in/yourprofile"
        },
        {
            "key": "youtube_url",
            "label": "YouTube URL",
            "type": "text",
            "default": "",
            "placeholder": "https://youtube.com/c/yourchannel"
        },
        {
            "key": "tiktok_url",
            "label": "TikTok URL",
            "type": "text",
            "default": "",
            "placeholder": "https://tiktok.com/@youraccount"
        },
        {
            "key": "pinterest_url",
            "label": "Pinterest URL",
            "type": "text",
            "default": "",
            "placeholder": "https://pinterest.com/youraccount"
        },
        {
            "key": "whatsapp_number",
            "label": "WhatsApp Number",
            "type": "text",
            "default": "",
            "placeholder": "+1234567890"
        },
        {
            "key": "email_address",
            "label": "Email Address",
            "type": "text",
            "default": "",
            "placeholder": "contact@yoursite.com"
        },
        {
            "key": "icon_style",
            "label": "Icon Style",
            "type": "select",
            "options": ["filled", "outlined", "rounded", "square"],
            "default": "filled"
        },
        {
            "key": "icon_size",
            "label": "Icon Size",
            "type": "select",
            "options": ["small", "medium", "large", "extra-large"],
            "default": "medium"
        },
        {
            "key": "layout",
            "label": "Layout",
            "type": "select",
            "options": ["horizontal", "vertical", "grid"],
            "default": "horizontal"
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "select",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "mobile_alignment",
            "label": "Mobile Alignment",
            "type": "select",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "spacing",
            "label": "Icon Spacing",
            "type": "range",
            "default": 16,
            "min": 4,
            "max": 40
        },
        {
            "key": "hover_effect",
            "label": "Hover Effect",
            "type": "select",
            "options": ["none", "scale", "bounce", "rotate"],
            "default": "scale"
        },
        {
            "key": "open_new_tab",
            "label": "Open in New Tab",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "yes"
        },
        {
            "key": "show_labels",
            "label": "Show Labels",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "no"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        }
    ]
}
{
    "type": "pricing_card",
    "name": "Pricing Card",
    "icon": "fa-credit-card",
    "order": 13,
    "category": "Pricing",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "plan_name",
            "label": "Plan Name",
            "type": "text",
            "default": "Basic Plan",
            "placeholder": "Enter plan name"
        },
        {
            "key": "plan_description",
            "label": "Plan Description",
            "type": "text",
            "default": "Perfect for individuals",
            "placeholder": "Short plan description"
        },
        {
            "key": "price_monthly",
            "label": "Monthly Price",
            "type": "text",
            "default": "$29",
            "placeholder": "Monthly price"
        },
        {
            "key": "price_yearly",
            "label": "Yearly Price",
            "type": "text",
            "default": "$290",
            "placeholder": "Yearly price"
        },
        {
            "key": "price_period",
            "label": "Price Period",
            "type": "text",
            "default": "/month",
            "placeholder": "Billing period"
        },
        {
            "key": "currency_symbol",
            "label": "Currency Symbol",
            "type": "text",
            "default": "$",
            "placeholder": "Currency symbol"
        },
        {
            "key": "features_list",
            "label": "Features List",
            "type": "textarea",
            "default": "10 Projects\n50GB Storage\nEmail Support\n24/7 Access\nBasic Analytics",
            "placeholder": "One feature per line"
        },
        {
            "key": "button_text",
            "label": "Button Text",
            "type": "text",
            "default": "Get Started",
            "placeholder": "Button text"
        },
        {
            "key": "button_url",
            "label": "Button URL",
            "type": "text",
            "default": "#",
            "placeholder": "Button URL"
        },
        {
            "key": "button_style",
            "label": "Button Style",
            "type": "select",
            "options": ["primary", "secondary", "outline"],
            "default": "primary"
        },
        {
            "key": "is_popular",
            "label": "Popular Plan",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "no"
        },
        {
            "key": "popular_badge_text",
            "label": "Popular Badge Text",
            "type": "text",
            "default": "Most Popular",
            "placeholder": "Badge text"
        },
        {
            "key": "card_style",
            "label": "Card Style",
            "type": "select",
            "options": ["minimal", "bordered", "shadow", "elevated", "gradient"],
            "default": "shadow"
        },
        {
            "key": "hover_effect",
            "label": "Hover Effect",
            "type": "select",
            "options": ["none", "lift", "scale", "glow"],
            "default": "lift"
        },
        {
            "key": "price_highlight",
            "label": "Price Highlight",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "enable"
        },
        {
            "key": "show_original_price",
            "label": "Show Original Price",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "no"
        },
        {
            "key": "original_price",
            "label": "Original Price",
            "type": "text",
            "default": "$49",
            "placeholder": "Original price (crossed out)"
        },
        {
            "key": "discount_percentage",
            "label": "Discount Percentage",
            "type": "text",
            "default": "40% OFF",
            "placeholder": "Discount text"
        },
        {
            "key": "features_icon",
            "label": "Features Icon",
            "type": "select",
            "options": ["checkmark", "arrow", "star", "none"],
            "default": "checkmark"
        },
        {
            "key": "text_alignment",
            "label": "Text Alignment",
            "type": "select",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "mobile_alignment",
            "label": "Mobile Alignment",
            "type": "select",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "border_radius",
            "label": "Border Radius",
            "type": "range",
            "min": 0,
            "max": 24,
            "default": 12
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "min": 0,
            "max": 50,
            "default": 32
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "min": 0,
            "max": 50,
            "default": 32
        },
        {
            "key": "padding_left",
            "label": "Padding Left",
            "type": "range",
            "min": 0,
            "max": 50,
            "default": 24
        },
        {
            "key": "padding_right",
            "label": "Padding Right",
            "type": "range",
            "min": 0,
            "max": 50,
            "default": 24
        }
    ]
}
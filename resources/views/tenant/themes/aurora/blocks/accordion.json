{
    "type": "accordion",
    "name": "Accordion",
    "icon": "fa-list",
    "order": 12,
    "category": "Interactive",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "accordion_items",
            "label": "Accordion Items",
            "type": "repeater",
            "max_items": 10,
            "fields": [
                {
                    "key": "title",
                    "label": "Title",
                    "type": "text",
                    "default": "Accordion Item"
                },
                {
                    "key": "content",
                    "label": "Content",
                    "type": "textarea",
                    "default": "This is the accordion content. You can add any text here."
                },
                {
                    "key": "is_open",
                    "label": "Open by Default",
                    "type": "radio",
                    "options": ["yes", "no"],
                    "default": "no"
                }
            ],
            "default": [
                {
                    "title": "What is your return policy?",
                    "content": "We offer a 30-day return policy for all unused items in their original packaging.",
                    "is_open": "yes"
                },
                {
                    "title": "How long does shipping take?",
                    "content": "Standard shipping takes 3-5 business days. Express shipping is available for next-day delivery.",
                    "is_open": "no"
                },
                {
                    "title": "Do you offer customer support?",
                    "content": "Yes, we provide 24/7 customer support via email, phone, and live chat.",
                    "is_open": "no"
                }
            ]
        },
        {
            "key": "accordion_style",
            "label": "Accordion Style",
            "type": "select",
            "options": ["bordered", "minimal", "card", "shadow"],
            "default": "bordered"
        },
        {
            "key": "allow_multiple",
            "label": "Allow Multiple Open",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "no"
        },
        {
            "key": "icon_style",
            "label": "Icon Style",
            "type": "select",
            "options": ["plus_minus", "chevron", "arrow", "none"],
            "default": "plus_minus"
        },
        {
            "key": "icon_position",
            "label": "Icon Position",
            "type": "radio",
            "options": ["left", "right"],
            "default": "right"
        },
        {
            "key": "animation_speed",
            "label": "Animation Speed",
            "type": "select",
            "options": ["fast", "normal", "slow"],
            "default": "normal"
        },
        {
            "key": "title_size",
            "label": "Title Size",
            "type": "select",
            "options": ["small", "medium", "large"],
            "default": "medium"
        },
        {
            "key": "spacing",
            "label": "Item Spacing",
            "type": "range",
            "default": 8,
            "min": 0,
            "max": 32
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        }
    ]
}
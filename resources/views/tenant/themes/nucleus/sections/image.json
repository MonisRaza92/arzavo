{
    "type": "image",
    "name": "Image: Full Width",
    "icon": "fa-image",
    "order": 8,
    "category": "Banners",
    "color_scheme": "scheme_1",
    "max_blocks": 10,
    "allowed_blocks": [
        "heading",
        "text",
        "button",
        "group",
        "icon",
        "spacer"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Image"
        },
        {
            "key": "desktop_image",
            "label": "Desktop Image",
            "type": "image"
        },
        {
            "key": "mobile_image",
            "label": "Mobile Image",
            "type": "image"
        },
        {
            "key": "alt_text",
            "label": "Alt Text",
            "type": "text"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "media_stack",
            "label": "Stack Content",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "direction",
            "label": "Content Direction",
            "type": "radio",
            "options": [
                "vertical",
                "horizontal"
            ],
            "default": "vertical",
            "conditional": {
                "field": "media_stack",
                "value": "1"
            }
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": [
                "start",
                "center",
                "end"
            ],
            "default": "center",
            "conditional": {
                "field": "media_stack",
                "value": "0"
            }
        },
        {
            "key": "position",
            "label": "Position",
            "type": "select",
            "options": [
                "start",
                "center",
                "end",
                "between"
            ],
            "default": "center",
            "conditional": {
                "field": "media_stack",
                "value": "0"
            }
        },
        {
            "key": "gap",
            "label": "Content Gap",
            "type": "range",
            "default": 16,
            "min": 0,
            "max": 100
        },
        {
            "key": "group",
            "type": "group",
            "label": "Appearence",
            "icon": "fa-image"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Width & Height"
        },
        {
            "key": "container_width",
            "label": "Container Width",
            "type": "radio",
            "options": [
                "container",
                "full"
            ],
            "default": "full"
        },
        {
            "key": "aspect_ratio",
            "label": "Aspect Ratio",
            "type": "select",
            "default": "auto",
            "options": [
                "auto",
                "square",
                "portrait",
                "landscape",
                "wide"
            ]
        },
        {
            "key": "image_fit",
            "label": "Image Fit",
            "type": "radio",
            "options": [
                "cover",
                "contain"
            ],
            "default": "cover"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Overlay"
        },
        {
            "key": "overlay_enable",
            "label": "Enable Overlay",
            "type": "switch",
            "default": "0",
            "conditional": {
                "field": "media_stack",
                "value": "0"
            }
        },
        {
            "key": "overlay_color",
            "label": "Overlay Color",
            "type": "color",
            "default": "#000000",
            "conditional": {
                "field": "overlay_enable",
                "value": "1"
            }
        },
        {
            "key": "overlay_opacity",
            "label": "Overlay Opacity",
            "type": "range",
            "default": 40,
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "overlay_enable",
                "value": "1"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Style"
        },
        {
            "key": "border_width",
            "label": "Border Thickness",
            "type": "range",
            "min": 0,
            "max": 20,
            "default": 0,
            "conditional": [
                {
                    "field": "container_width",
                    "value": "container"
                },
                {
                    "field": "media_stack",
                    "value": "0"
                }
            ]
        },
        {
            "key": "border_radius",
            "label": "Border Roundness",
            "type": "range",
            "min": 0,
            "max": 200,
            "default": 0,
            "conditional": [
                {
                    "field": "container_width",
                    "value": "container"
                },
                {
                    "field": "media_stack",
                    "value": "0"
                }
            ]
        },
        {
            "key": "opacity",
            "label": "Opacity %",
            "type": "range",
            "min": 10,
            "max": 100,
            "default": 100
        },
        {
            "key": "group",
            "type": "group",
            "label": "Spacing"
        },
        {
            "key": "margin_top",
            "type": "range",
            "label": "Padding Top",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "margin_bottom",
            "type": "range",
            "label": "Padding Bottom",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "group",
            "type": "group",
            "label": "Visibility"
        },
        {
            "key": "hide_desktop",
            "label": "Hide this section on desktop",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "hide_mobile",
            "label": "Hide this section on Mobile",
            "type": "switch",
            "default": "0"
        }
    ]
}
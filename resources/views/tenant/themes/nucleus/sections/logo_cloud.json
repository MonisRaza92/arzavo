{
    "type": "logo_cloud",
    "name": "Logo Cloud",
    "icon": "fa-images",
    "category": "Storytelling",
    "order": 14,
    "color_scheme": "scheme_1",
    "max_blocks": 20,
    "allowed_blocks": ["header", "heading", "text", "logo_item"],
    "default_blocks": [
        {
            "type": "header",
            "settings": {
                "alignment": "center",
                "gap": 8,
                "padding_bottom": 0
            },
            "default_blocks": [
                {
                    "type": "heading",
                    "settings": {
                        "text": "Trusted By Leading Institutions",
                        "heading_type": "heading-5",
                        "alignment": "center"
                    }
                }
            ]
        },
        "logo_item",
        "logo_item",
        "logo_item",
        "logo_item",
        "logo_item",
        "logo_item"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "layout_style",
            "label": "Layout",
            "type": "radio",
            "options": ["grid", "marquee"],
            "default": "grid"
        },
        {
            "key": "columns",
            "label": "Desktop Columns",
            "type": "range",
            "min": 3,
            "max": 8,
            "default": 6,
            "conditional": {
                "field": "layout_style",
                "value": "grid"
            }
        },
        {
            "key": "mobile_columns",
            "label": "Mobile Columns",
            "type": "range",
            "min": 2,
            "max": 4,
            "default": 3,
            "conditional": {
                "field": "layout_style",
                "value": "grid"
            }
        },
        {
            "key": "gap",
            "label": "Items Gap",
            "type": "range",
            "default": 32,
            "min": 0,
            "max": 80
        },
        {
            "key": "logo_height",
            "label": "Logo Height (px)",
            "type": "range",
            "default": 48,
            "min": 24,
            "max": 120
        },
        {
            "key": "grayscale",
            "label": "Grayscale Logos",
            "type": "switch",
            "default": "1"
        },
        {
            "key": "marquee_speed",
            "label": "Marquee Speed (s)",
            "type": "range",
            "default": 30,
            "min": 10,
            "max": 60,
            "conditional": {
                "field": "layout_style",
                "value": "marquee"
            }
        },
        {
            "preset": "section_bg_type_fields"
        },
        {
            "preset": "bg_overlay_fields"
        },
        {
            "preset": "section_spacing"
        },
        {
            "preset": "visibility_fields"
        }
    ]
}

{
    "type": "dataset_container",
    "name": "Categories",
    "icon": "fa-graduation-cap",
    "category": "Content",
    "color_scheme": "scheme_1",
    "max_blocks": 20,
    "allowed_blocks": [
        "header",
        "heading",
        "text",
        "button",
        "category_card"
    ],
    "default_blocks": [
        {
            "type": "header",
            "settings": {
                "alignment": "center",
                "gap": 8
            },
            "default_blocks": [
                {
                    "type": "heading",
                    "settings": {
                        "text": "Explore Categories",
                        "heading_type": "heading-3",
                        "alignment": "center"
                    }
                },
                {
                    "type": "text",
                    "settings": {
                        "text": "Choose from our wide range of academic and competitive categories to find the class that fits your goals.",
                        "alignment": "center"
                    }
                }
            ]
        },
        "category_card"
    ],
    "fields": [
        {
            "key": "layout_group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "dataset_source",
            "type": "hidden",
            "default": "categories"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },

        {
            "key": "gap",
            "label": "Items Gap",
            "type": "range",
            "default": 24,
            "min": 0,
            "max": 80
        },
        {
            "key": "show_limit",
            "label": "Items Limit",
            "type": "range",
            "default": 6,
            "min": 1,
            "max": 24
        },

        {
            "key": "columns",
            "label": "Desktop Columns",
            "type": "range",
            "min": 2,
            "max": 6,
            "default": 3,
            "conditional": {
                "field": "layout_style",
                "value": "grid"
            }
        },
        {
            "key": "mobile_columns",
            "label": "Mobile Columns",
            "type": "range",
            "min": 1,
            "max": 3,
            "default": 1,
            "conditional": {
                "field": "layout_style",
                "value": "grid"
            }
        },
        {
            "preset": "section_spacing_fields"
        },
        {
            "preset": "section_mobile_spacing_fields"
        },
        {
            "preset": "visibility_fields"
        }
    ]
}
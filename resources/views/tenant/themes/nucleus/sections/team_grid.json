{
    "type": "team_grid",
    "name": "Team Grid",
    "icon": "fa-users",
    "order": 12,
    "page": ["about", "team"],
    "category": "Team",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "section_title",
            "label": "Section Title",
            "type": "text",
            "default": "Meet Our Team",
            "placeholder": "Enter section title"
        },
        {
            "key": "section_subtitle",
            "label": "Section Subtitle",
            "type": "textarea",
            "default": "The passionate people behind our success",
            "placeholder": "Enter section subtitle"
        },
        {
            "key": "grid_columns",
            "label": "Grid Columns",
            "type": "select",
            "options": ["2", "3", "4"],
            "default": "3"
        },
        {
            "key": "team_members",
            "label": "Team Members (JSON)",
            "type": "textarea",
            "default": "[\n  {\n    \"name\": \"John Smith\",\n    \"position\": \"CEO & Founder\",\n    \"image\": \"\",\n    \"bio\": \"Passionate leader with 10+ years experience\"\n  },\n  {\n    \"name\": \"Sarah Davis\",\n    \"position\": \"CTO\",\n    \"image\": \"\",\n    \"bio\": \"Tech expert driving innovation\"\n  },\n  {\n    \"name\": \"Mike Johnson\",\n    \"position\": \"Head of Design\",\n    \"image\": \"\",\n    \"bio\": \"Creative visionary and design guru\"\n  }\n]",
            "placeholder": "Enter team members in JSON format"
        },
        {
            "key": "show_bio",
            "label": "Show Bio",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "yes"
        },
        {
            "key": "card_style",
            "label": "Card Style",
            "type": "select",
            "options": ["simple", "bordered", "shadow", "elevated"],
            "default": "shadow"
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 60
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 60
        }
    ]
}
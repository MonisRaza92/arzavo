{
    "type": "pricing_table",
    "name": "Pricing Section",
    "icon": "fa-tags",
    "order": 10,
    "page": ["home", "pricing"],
    "category": "Pricing",
    "max_blocks": 10,
    "allowed_blocks": [
        "heading",
        "text",
        "pricing_card",
        "divider",
        "button"
    ],
    "default_blocks": [
        "heading",
        "text",
        "pricing_card",
        "pricing_card",
        "pricing_card"
    ],
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "layout_style",
            "label": "Layout Style",
            "type": "select",
            "options": ["grid", "horizontal_scroll", "stacked"],
            "default": "grid"
        },
        {
            "key": "columns_desktop",
            "label": "Columns (Desktop)",
            "type": "select",
            "options": ["1", "2", "3", "4", "5"],
            "default": "3"
        },
        {
            "key": "columns_mobile",
            "label": "Columns (Mobile)",
            "type": "select",
            "options": ["1", "2"],
            "default": "1"
        },
        {
            "key": "card_spacing",
            "label": "Card Spacing",
            "type": "select",
            "options": ["tight", "normal", "wide"],
            "default": "normal"
        },
        {
            "key": "content_alignment",
            "label": "Content Alignment",
            "type": "select",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "equal_height",
            "label": "Equal Height Cards",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "enable"
        },
        {
            "key": "billing_toggle",
            "label": "Show Billing Toggle",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        },
        {
            "key": "monthly_label",
            "label": "Monthly Label",
            "type": "text",
            "default": "Monthly",
            "placeholder": "Monthly billing label"
        },
        {
            "key": "yearly_label",
            "label": "Yearly Label",
            "type": "text",
            "default": "Yearly",
            "placeholder": "Yearly billing label"
        },
        {
            "key": "yearly_discount",
            "label": "Yearly Discount Text",
            "type": "text",
            "default": "Save 20%",
            "placeholder": "Discount text for yearly billing"
        },
        {
            "key": "show_guarantee",
            "label": "Show Money Back Guarantee",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "yes"
        },
        {
            "key": "guarantee_text",
            "label": "Guarantee Text",
            "type": "text",
            "default": "30-day money-back guarantee",
            "placeholder": "Guarantee text"
        },
        {
            "key": "animation_enabled",
            "label": "Animation",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "enable"
        },
        {
            "key": "stagger_animation",
            "label": "Stagger Animation",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "enable"
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 60
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 60
        }
    ]
}
{
    "view": "testimonials",
    "name": "Testimonials",
    "icon": "fa-quote-left",
    "category": "Trust Building",
    "order": 10,
    "color_scheme": "scheme_1",
    "max_blocks": 20,
    "allowed_blocks": [
        "header",
        "heading",
        "text",
        "testimonial_card"
    ],
    "default_blocks": [
        {
            "type": "header",
            "settings": {
                "alignment": "center",
                "gap": 8,
                "padding_bottom": 0
            },
            "default_blocks": [
                {
                    "type": "heading",
                    "settings": {
                        "text": "What Our Clients Say",
                        "heading_type": "heading-4",
                        "alignment": "center"
                    }
                },
                {
                    "type": "text",
                    "settings": {
                        "text": "Hear from the people who trust us with their institution management.",
                        "alignment": "center"
                    }
                }
            ]
        },
        "testimonial_card",
        "testimonial_card",
        "testimonial_card"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "layout_style",
            "label": "Layout Style",
            "type": "radio",
            "options": [
                "grid",
                "carousel"
            ],
            "default": "grid"
        },
        {
            "key": "columns",
            "label": "Desktop Columns",
            "type": "range",
            "min": 1,
            "max": 4,
            "default": 3,
            "conditional": {
                "field": "layout_style",
                "value": "grid"
            }
        },
        {
            "key": "mobile_columns",
            "label": "Mobile Columns",
            "type": "range",
            "min": 1,
            "max": 2,
            "default": 1,
            "conditional": {
                "field": "layout_style",
                "value": "grid"
            }
        },
        {
            "key": "gap",
            "label": "Items Gap",
            "type": "range",
            "default": 24,
            "min": 0,
            "max": 80
        },
        {
            "key": "carousel_group",
            "type": "group",
            "label": "Carousel Settings",
            "conditional": {
                "field": "layout_style",
                "value": "carousel"
            }
        },
        {
            "key": "slides_visible",
            "label": "Desktop Cards",
            "type": "range",
            "min": 1,
            "max": 4,
            "default": 3,
            "conditional": {
                "field": "layout_style",
                "value": "carousel"
            }
        },
        {
            "key": "slides_visible_mobile",
            "label": "Mobile Cards",
            "type": "range",
            "min": 1,
            "max": 2,
            "default": 1,
            "conditional": {
                "field": "layout_style",
                "value": "carousel"
            }
        },
        {
            "key": "show_arrows",
            "label": "Show Arrows",
            "type": "switch",
            "default": "1",
            "conditional": {
                "field": "layout_style",
                "value": "carousel"
            }
        },
        {
            "preset": "section_bg_type_fields"
        },
        {
            "preset": "bg_overlay_fields"
        },
        {
            "preset": "section_spacing_fields"
        },
        {
            "preset": "section_mobile_spacing_fields"
        },
        {
            "preset": "visibility_fields"
        }
    ]
}
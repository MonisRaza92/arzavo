{
    "type": "newsletter_banner",
    "name": "Newsletter Banner",
    "icon": "fa-solid fa-envelope-open-text",
    "category": "Footer",
    "max_blocks": 0,
    "color_scheme": "scheme_1",
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Content",
            "icon": "fa-solid fa-heading"
        },
        {
            "key": "title",
            "label": "Heading",
            "type": "text",
            "default": "Join our newsletter"
        },
        {
            "key": "description",
            "label": "Description",
            "type": "textarea",
            "default": "Stay updated with our latest news and exclusive offers."
        },
        {
            "key": "placeholder",
            "label": "Input Placeholder",
            "type": "text",
            "default": "Enter your email"
        },
        {
            "key": "button_text",
            "label": "Button Text",
            "type": "text",
            "default": "Subscribe"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Layout & Style",
            "icon": "fa-solid fa-palette"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "preset": "section_spacing"
        },
        {
            "key": "alignment",
            "label": "Text Alignment",
            "type": "radio",
            "options": ["left", "center"],
            "default": "center"
        }
    ]
}

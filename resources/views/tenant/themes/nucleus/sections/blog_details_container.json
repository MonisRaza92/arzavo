{
    "type": "details_container",
    "name": "Blog: Details",
    "icon": "fa-newspaper",
    "category": "Content",
    "pages": [
        "blog"
    ],
    "color_scheme": "scheme_1",
    "max_blocks": 25,
    "allowed_blocks": [
        "data_details_group",
        "data_image",
        "data_title",
        "data_author",
        "data_badge",
        "data_pills",
        "data_stats",
        "data_text",
        "data_description",
        "divider",
        "spacer"
    ],
    "default_blocks": [
        {
            "type": "data_details_group",
            "settings": {
                "direction": "vertical",
                "gap": 24,
                "padding_y": 24
            },
            "default_blocks": [
                {
                    "type": "data_image",
                    "settings": {
                        "aspect_ratio": "wide",
                        "border_radius": 12
                    }
                },
                {
                    "type": "data_badge",
                    "settings": {
                        "show_icons": true,
                        "border_radius": 20
                    }
                },
                {
                    "type": "data_title",
                    "settings": {
                        "heading_type": "h3",
                        "enable_text_limit": false
                    }
                },
                {
                    "type": "data_author",
                    "settings": {
                        "alignment": "left"
                    }
                },
                "data_description"
            ]
        }
    ],
    "fields": [
        {
            "key": "layout_group",
            "type": "group",
            "label": "Layout Settings",
            "icon": "fa-layer-group"
        },
        {
            "key": "dataset_source",
            "type": "hidden",
            "default": "blog"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "width",
            "label": "Container Size",
            "type": "radio",
            "options": [
                "full_width",
                "container"
            ],
            "default": "container"
        },
        {
            "key": "direction",
            "label": "Direction",
            "type": "radio",
            "options": [
                "vertical",
                "horizontal"
            ],
            "default": "vertical"
        },
        {
            "key": "gap",
            "type": "range",
            "default": 32,
            "min": 0,
            "max": 200
        },
        {
            "preset": "section_spacing_fields"
        },
        {
            "preset": "section_mobile_spacing_fields"
        },
        {
            "preset": "visibility_fields"
        }
    ]
}

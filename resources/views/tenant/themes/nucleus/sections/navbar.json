{
    "type": "navbar",
    "name": "Header: Navbar",
    "icon": "fa-bars",
    "order": 1,
    "Page": ["global"],
    "category": "Header",
    "max_blocks": 2,
    "color_scheme_id": 1,
    "allowed_blocks": ["logo", "menu"],
    "default_blocks": ["logo", "menu"],
    "moveable": "none",
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "General"
        },
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "navbar_behavior",
            "label": "Behavior",
            "type": "radio",
            "options": ["sticky", "scroll-up"],
            "default": "sticky"
        },
        {
            "key": "transparent",
            "label": "Transparent",
            "type": "switch",
            "default": "0",
            "text": "Enable to make navbar transparent",
            "conditional": {
                "field": "navbar_behavior",
                "value": "sticky"
            }
        },

        {
            "key": "group",
            "type": "group",
            "label": "Layout"
        },
        {
            "key": "navbar_height",
            "label": "Height",
            "type": "select",
            "options": ["compact", "standard", "spacious"],
            "default": "standard"
        },
        {
            "key": "links_position",
            "label": "Links Position",
            "type": "radio",
            "options": ["left", "right"],
            "default": "right"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Style"
        },
        {
            "key": "divider",
            "label": "Divider",
            "type": "switch",
            "default": "1",
            "text": "Enable to add divider in bottom"
        },
        {
            "key": "icon_style",
            "label": "Icon Style",
            "type": "radio",
            "options": ["outline", "solid"],
            "default": "outline"
        }
    ]
}

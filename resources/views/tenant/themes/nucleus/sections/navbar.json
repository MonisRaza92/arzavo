{
    "type": "navbar",
    "name": "Header: Navbar",
    "icon": "fa-bars",
    "order": 2,
    "Page": [
        "global"
    ],
    "category": "Header",
    "max_blocks": 2,
    "color_scheme": "scheme_1",
    "allowed_blocks": [
        "logo",
        "menu"
    ],
    "default_blocks": [
        "logo",
        "menu"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "General"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "navbar_behavior",
            "label": "Behavior",
            "type": "radio",
            "options": [
                "sticky",
                "scroll-up"
            ],
            "default": "sticky"
        },
        {
            "key": "transparent",
            "label": "Transparent header on home",
            "type": "switch",
            "default": "0",
            "conditional": {
                "field": "navbar_behavior",
                "value": "sticky"
            }
        },
        {
            "key": "invert_color_scheme",
            "label": "Invert Scheme",
            "type": "invert_color_scheme",
            "help": "Select a color scheme to be used when the header is in transparent mode.",
            "conditional": {
                "field": "transparent",
                "value": "1"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Layout"
        },
        {
            "key": "links_position",
            "label": "Links Position",
            "type": "radio",
            "options": [
                "left",
                "right"
            ],
            "default": "right"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Style"
        },
        {
            "key": "divider",
            "label": "Divider Width",
            "type": "range",
            "default": "1",
            "min": 0,
            "max": 5
        },
        {
            "key": "icon_style",
            "label": "Icon Style",
            "type": "radio",
            "options": [
                "outline",
                "solid"
            ],
            "default": "outline"
        }
    ]
}
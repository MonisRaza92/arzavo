{
    "type": "navbar",
    "name": "Header: Navbar",
    "icon": "fa-bars",
    "order": 2,
    "Page": [
        "global"
    ],
    "category": "Header",
    "max_blocks": 2,
    "color_scheme": "scheme_1",
    "allowed_blocks": [
        "logo",
        "nav_menu"
    ],
    "default_blocks": [
        "logo",
        "nav_menu"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "General"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector",
            "help": "Choose a color scheme for the navbar. You can customize color schemes in the Theme Settings."
        },
        {
            "key": "navbar_behavior",
            "label": "Behavior",
            "type": "radio",
            "options": [
                "sticky",
                "scroll-up"
            ],
            "default": "sticky",
            "help": "Sticky: Navbar stays at the top of the page when scrolling. Scroll-up: Navbar hides when scrolling down and shows when scrolling up."
        },
        {
            "key": "group",
            "type": "group",
            "label": "Layout"
        },
        {
            "key": "width",
            "label": "Width",
            "type": "radio",
            "options": [
                "full-width",
                "container"
            ],
            "default": "container"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Style"
        },
        {
            "key": "divider",
            "label": "Divider Width",
            "type": "range",
            "default": "1",
            "min": 0,
            "max": 5
        },
        {
            "key": "icon_size",
            "label": "Icon Size",
            "type": "range",
            "default": "20",
            "min": 16,
            "max": 48
        }
    ]
}
{
    "type": "announcement_bar",
    "name": "Announcement Bar",
    "icon": "fa-bullhorn",
    "order": 0,
    "category": "Header",
    "page": "home",
    "max_blocks": 1,
    "allowed_blocks": ["announcement"],
    "default_blocks": ["announcement"],
    "moveable": "none",
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "bar_style",
            "label": "Bar Style",
            "type": "select",
            "options": ["solid", "gradient", "bordered", "minimal"],
            "default": "solid"
        },
        {
            "key": "bar_position",
            "label": "Bar Position",
            "type": "radio",
            "options": ["top", "bottom"],
            "default": "top"
        },
        {
            "key": "bar_behavior",
            "label": "Bar Behavior",
            "type": "select",
            "options": ["static", "sticky", "fixed"],
            "default": "static"
        },
        {
            "key": "animation_type",
            "label": "Animation Type",
            "type": "select",
            "options": ["none", "slide_down", "fade_in", "bounce"],
            "default": "slide_down"
        },
        {
            "key": "text_animation",
            "label": "Text Animation",
            "type": "select",
            "options": ["none", "scroll", "blink", "pulse"],
            "default": "none"
        },
        {
            "key": "padding",
            "label": "Vertical Spacing",
            "type": "range",
            "default": 1,
            "min": 0,
            "max": 4
        },
        {
            "key": "text_alignment",
            "label": "Text Alignment",
            "type": "select",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "mobile_alignment",
            "label": "Mobile Alignment",
            "type": "select",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "show_icon",
            "label": "Show Icon",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "yes"
        },
        {
            "key": "icon_position",
            "label": "Icon Position",
            "type": "radio",
            "options": ["left", "right"],
            "default": "left"
        },
        {
            "key": "divider",
            "label": "Divider Bottom",
            "type": "radio",
            "default": "enable",
            "options": ["enable", "disable"]
        },
        {
            "key": "bar_hide_btn",
            "label": "Bar Hide Button",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "enable"
        },
        {
            "key": "hide_button_style",
            "label": "Hide Button Style",
            "type": "select",
            "options": ["cross", "arrow", "text"],
            "default": "cross"
        },
        {
            "key": "auto_hide",
            "label": "Auto Hide After (seconds)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 30,
            "help": "0 = Never auto hide"
        },
        {
            "key": "show_on_pages",
            "label": "Show On Pages",
            "type": "select",
            "options": ["all", "home_only", "specific"],
            "default": "all"
        },
        {
            "key": "border_radius",
            "label": "Border Radius",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 20
        }
    ]
}

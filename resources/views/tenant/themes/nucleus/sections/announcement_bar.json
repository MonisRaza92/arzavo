{
    "type": "announcement_bar",
    "name": "Announcement Bar",
    "icon": "fa-rss",
    "order": 0,
    "category": "Header",
    "color_scheme": "scheme_1",
    "max_blocks": 10,
    "allowed_blocks": [
        "announcement"
    ],
    "default_blocks": [
        "announcement"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "container_width",
            "label": "Section Width",
            "type": "radio",
            "options": [
                "container",
                "full"
            ],
            "default": "container"
        },
        {
            "key": "divider",
            "label": "Divider Thickness",
            "type": "range",
            "min": 0,
            "max": 5,
            "default": "1"
        },
        {
            "key": "padding_y",
            "label": "Vertical Padding",
            "type": "range",
            "default": 8,
            "min": 0,
            "max": 40
        },
        {
            "key": "group",
            "type": "group",
            "label": "Behaviour",
            "icon": "fa-rotate"
        },
        {
            "key": "auto_rotate",
            "label": "Auto Rotate",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "rotate_speed",
            "label": "Rotate Speed (ms)",
            "type": "number",
            "default": 4,
            "min": 1,
            "max": 10,
            "conditional": {
                "field": "auto_rotate",
                "value": "1"
            }
        }
    ]
}
{
    "type": "announcement_bar",
    "name": "Announcement Bar",
    "icon": "fa-solid fa-bullhorn",
    "category": "Header",
    "color_scheme": "scheme_1",
    "max_blocks": 10,
    "allowed_blocks": [
        "announcement"
    ],
    "default_blocks": [
        "announcement"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-solid fa-layer-group"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "container_width",
            "label": "Section Width",
            "type": "radio",
            "options": [
                "container",
                "full"
            ],
            "default": "container"
        },
        {
            "key": "divider",
            "label": "Divider Thickness",
            "type": "range",
            "min": 0,
            "max": 5,
            "default": "1"
        },
        {
            "key": "padding_y",
            "label": "Vertical Padding",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 40
        },
        {
            "key": "alignment",
            "label": "Text Alignment",
            "type": "radio",
            "options": [
                "left",
                "center",
                "right"
            ],
            "default": "center"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Behaviour",
            "icon": "fa-solid fa-rotate"
        },
        {
            "key": "transition_effect",
            "label": "Transition Effect",
            "type": "select",
            "options": [
                "slide",
                "fade",
                "slide-vertical"
            ],
            "default": "slide"
        },
        {
            "key": "auto_rotate",
            "label": "Auto Rotate",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "rotate_speed",
            "label": "Rotate Speed (s)",
            "type": "number",
            "default": 3,
            "min": 1,
            "max": 10,
            "conditional": {
                "field": "auto_rotate",
                "value": "1"
            }
        },
        {
            "key": "show_arrows",
            "label": "Show Control Arrows",
            "type": "switch",
            "default": "1"
        },
        {
            "key": "show_dots",
            "label": "Show Pagination Indicators",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "dismissible",
            "label": "Allow User to Dismiss",
            "type": "switch",
            "default": "1"
        }
    ]
}
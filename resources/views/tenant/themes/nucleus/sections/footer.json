{
    "type": "footer",
    "name": "Footer",
    "icon": "fa-tv",
    "category": "Footer",
    "color_scheme": "scheme_1",
    "max_blocks": 20,
    "allowed_blocks": [
        "heading",
        "text",
        "image",
        "button",
        "divider",
        "group",
        "icon",
        "spacer",
        "video",
        "logo",
        "menu"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "columns",
            "label": "Desktop Columns",
            "type": "range",
            "default": 4,
            "min": 1,
            "max": 6
        },
        {
            "key": "mobile_columns",
            "label": "Mobile Columns",
            "type": "range",
            "default": 1,
            "min": 1,
            "max": 2
        },
        {
            "key": "gap",
            "label": "Columns Gap",
            "type": "range",
            "default": 32,
            "min": 0,
            "max": 100
        },
        {
            "key": "group",
            "type": "group",
            "label": "Width & Height",
            "icon": "fa-arrows-left-right"
        },
        {
            "key": "content_width",
            "label": "Content Width",
            "type": "radio",
            "options": [
                "container",
                "full"
            ],
            "default": "container"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Background",
            "icon": "fa-image"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "background_type",
            "label": "Background",
            "type": "radio",
            "options": [
                "none",
                "image"
            ],
            "default": "none"
        },

        {
            "key": "background_image",
            "label": "Background Image",
            "type": "image",
            "conditional": {
                "field": "background_type",
                "value": "image"
            }
        },
        {
            "preset": "section_spacing"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Copyright",
            "icon": "fa-copyright"
        },
        {
            "key": "show_copyright",
            "label": "Show Copyright Bar",
            "type": "switch",
            "default": "1"
        },
        {
            "key": "copyright_text",
            "label": "Copyright Text",
            "type": "text",
            "default": "© 2026 Your Company. All rights reserved.",
            "conditional": {
                "field": "show_copyright",
                "value": "1"
            }
        }
    ]
}
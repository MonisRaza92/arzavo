{
    "type": "utility_bar",
    "name": "Utility Bar",
    "icon": "fa-solid fa-link",
    "category": "Footer",
    "max_blocks": 4,
    "color_scheme": "scheme_1",
    "allowed_blocks": [
        "text",
        "social_icons",
        "menu"
    ],
    "default_blocks": [
        "text",
        "social_icons"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-solid fa-layer-group"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "container",
            "label": "Width",
            "type": "radio",
            "options": [
                "container",
                "full"
            ],
            "default": "container"
        },
        {
            "key": "justify",
            "label": "Content Alignment",
            "type": "radio",
            "options": [
                "left",
                "center",
                "between"
            ],
            "default": "between"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Style",
            "icon": "fa-solid fa-palette"
        },
        {
            "key": "padding_y",
            "label": "Vertical Padding",
            "type": "range",
            "default": 12,
            "min": 4,
            "max": 40
        },
        {
            "key": "border_top",
            "label": "Top Border",
            "type": "range",
            "default": 1,
            "min": 0,
            "max": 5
        }
    ]
}

{
    "type": "custom_section",
    "name": "Custom Section",
    "icon": "fa-square-dashed",
    "order": 3,
    "category": "Layout",
    "color_scheme": "scheme_1",
    "max_blocks": 10,
    "allowed_blocks": [
        "heading",
        "text",
        "image",
        "button",
        "divider",
        "group",
        "icon",
        "spacer",
        "video",
        "header",
        "courses_cards"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Section Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "direction",
            "label": "Direction",
            "type": "radio",
            "options": [
                "vertical",
                "horizontal"
            ],
            "default": "vertical"
        },
        {
            "key": "mobile_direction",
            "label": "Verticle direction on Mobile",
            "type": "switch",
            "default": "1",
            "conditional": {
                "field": "direction",
                "value": "horizontal"
            }
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": [
                "start",
                "center",
                "end"
            ],
            "default": "center"
        },
        {
            "key": "position",
            "label": "Content Position",
            "type": "select",
            "options": [
                "start",
                "center",
                "end",
                "between"
            ],
            "default": "center"
        },
        {
            "key": "mobile_alignment",
            "label": "Mobile Alignment",
            "type": "radio",
            "options": [
                "start",
                "center",
                "end"
            ],
            "default": "center"
        },
        {
            "key": "mobile_position",
            "label": "Mobile Position",
            "type": "select",
            "options": [
                "start",
                "center",
                "end",
                "between"
            ],
            "default": "center"
        },
        {
            "key": "gap",
            "label": "Blocks Gap",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "group",
            "type": "group",
            "label": "Size & Width",
            "icon": "fa-arrows-left-right"
        },
        {
            "key": "width",
            "label": "Content Width",
            "type": "radio",
            "options": [
                {
                    "label": "Full Width",
                    "value": "w-full"
                },
                {
                    "label": "Container",
                    "value": "container"
                }
            ],
            "default": "container"
        },
        {
            "key": "height",
            "label": "Desktop Height",
            "type": "radio",
            "options": [
                "auto",
                "full",
                "custom"
            ],
            "default": "full"
        },
        {
            "key": "custom_height",
            "label": "Custom Height (vh)",
            "type": "range",
            "default": 60,
            "min": 10,
            "max": 100,
            "conditional": {
                "field": "height",
                "value": "custom"
            }
        },
        {
            "key": "mobile_height",
            "label": "Full Height on Mobile",
            "type": "switch",
            "default": "1"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Appearence",
            "icon": "fa-image"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "background_type",
            "label": "Background",
            "type": "radio",
            "options": [
                "none",
                "image",
                "video"
            ],
            "default": "none"
        },
        {
            "key": "background_image",
            "label": "Background Image",
            "type": "image",
            "conditional": {
                "field": "background_type",
                "value": "image"
            }
        },
        {
            "key": "background_video",
            "label": "Background Video",
            "type": "video",
            "conditional": {
                "field": "background_type",
                "value": "video"
            }
        },
        {
            "key": "background_attachment",
            "label": "Background Scroll",
            "type": "radio",
            "options": [
                "scroll",
                "fixed"
            ],
            "default": "scroll",
            "conditional": {
                "field": "background_type",
                "value": "image"
            }
        },
        {
            "key": "background_blur",
            "label": "Background blur for image or video",
            "type": "switch",
            "default": "0",
            "conditional": {
                "field": "background_type",
                "operator": "!=",
                "value": "none"
            }
        },
        {
            "key": "background_blur_intensity",
            "label": "Blur Intensity",
            "type": "range",
            "default": 8,
            "min": 0,
            "max": 30,
            "conditional": {
                "field": "background_blur",
                "value": "1"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Overlay",
            "icon": "fa-square-plus",
            "conditional": {
                "field": "background_type",
                "operator": "!=",
                "value": "none"
            }
        },
        {
            "key": "background_overlay",
            "label": "Add overlay for image or video",
            "type": "switch",
            "default": "0",
            "conditional": {
                "field": "background_type",
                "operator": "!=",
                "value": "none"
            }
        },
        {
            "key": "overlay_color",
            "label": "Overlay Color",
            "type": "color",
            "default": "#000000",
            "conditional": [
                {
                    "field": "background_overlay",
                    "value": "1"
                },
                {
                    "field": "background_type",
                    "operator": "!=",
                    "value": "none"
                }
            ]
        },
        {
            "key": "overlay_opacity",
            "label": "Overlay Opacity",
            "type": "range",
            "default": 50,
            "min": 0,
            "max": 100,
            "conditional": [
                {
                    "field": "background_overlay",
                    "value": "1"
                },
                {
                    "field": "background_type",
                    "operator": "!=",
                    "value": "none"
                }
            ]
        },
        {
            "preset": "section_spacing"
        },
        {
            "preset": "visibility"
        }
    ]
}
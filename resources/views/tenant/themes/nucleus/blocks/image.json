{
    "type": "image",
    "name": "Image",
    "icon": "fa-image",
    "order": 4,
    "category": "Basic",
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Image"
        },
        {
            "key": "desktop_image",
            "label": "Desktop Image",
            "type": "image",
            "default": null
        },
        {
            "key": "mobile_image",
            "label": "Mobile Image",
            "type": "image",
            "default": null,
            "help": "Optionally upload a different image for mobile devices. If left blank, the desktop image will be used."
        },
        {
            "key": "alt_text",
            "label": "Alt Text",
            "type": "text",
            "default": "",
            "placeholder": "Describe the image (SEO & accessibility)",
            "help": "This text will be used for SEO and accessibility purposes. It describes the content of the image."
        },

        {
            "key": "group",
            "type": "group",
            "label": "Link"
        },
        {
            "key": "image_link",
            "label": "Image Link",
            "type": "url",
            "default": ""
        },
        {
            "key": "open_new_tab",
            "label": "Open in New Tab",
            "type": "switch",
            "default": 0,
            "conditional": {
                "field": "image_link",
                "operator": "!=",
                "value": ""
            }
        },

        {
            "key": "group",
            "type": "group",
            "label": "Style"
        },
        {
            "key": "aspect_ratio",
            "label": "Aspect Radio",
            "type": "select",
            "default": "auto",
            "options": ["auto", "square", "portrait", "landscape", "wide"]
        },
        {
            "key": "image_fit",
            "label": "Image Fit",
            "type": "select",
            "default": "cover",
            "options": ["cover", "contain", "auto"]
        },
        {
            "key": "border_width",
            "label": "Border Thickness",
            "type": "range",
            "min": 0,
            "max": 20,
            "default": "0"
        },
        {
            "key": "border_radius",
            "label": "Border Roundness",
            "type": "range",
            "min": 0,
            "max": 200,
            "default": "0"
        },
        {
            "key": "opacity",
            "label": "Opacity (%)",
            "type": "range",
            "min": 10,
            "max": 100,
            "default": "100"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Spacing"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "margin_left",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "margin_right",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },

        {
            "key": "group",
            "type": "group",
            "label": "Responsive"
        },
        {
            "key": "hide_desktop",
            "label": "Hide image on desktop",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "hide_mobile",
            "label": "Hide image on mobile",
            "type": "switch",
            "default": "0"
        }
    ]
}

{
    "type": "data_text",
    "name": "Description",
    "icon": "fa-align-left ml-0.5",
    "order": 2,
    "category": "Basic",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "group",
            "label": "Heading",
            "type": "group",
            "help": "Enable optional heading title above text content."
        },
        {
            "key": "show_heading",
            "label": "Show Heading",
            "type": "switch",
            "default": false
        },
        {
            "key": "heading",
            "label": "Heading Text",
            "type": "text",
            "default": "Overview",
            "placeholder": "Enter heading text...",
            "conditional": {
                "key": "show_heading",
                "value": true
            }
        },
        {
            "key": "heading_type",
            "label": "Heading Size / Type",
            "type": "select",
            "options": [
                {
                    "label": "Heading 1",
                    "value": "h1" 
                },
                {
                    "label": "Heading 2",
                    "value": "h2" 
                },
                {
                    "label": "Heading 3",
                    "value": "h3" 
                },
                {
                    "label": "Heading 4",
                    "value": "h4" 
                },
                {
                    "label": "Heading 5",
                    "value": "h5" 
                },
                {
                    "label": "Heading 6",
                    "value": "h6" 
                }
            ],
            "default": "h6",
            "conditional": {
                "key": "show_heading",
                "value": true
            }
        },

        {
            "key": "group",
            "label": "Content",
            "type": "group",
            "help": "Configure text type and limit text length."
        },
        {
            "key": "text_type",
            "label": "Text Type",
            "type": "select",
            "options": ["paragraph", "body-text"],
            "default": "body-text"
        },
        {
            "key": "enable_text_limit",
            "type": "switch",
            "default": true
        },
        {
            "key": "text_limit",
            "type": "range",
            "min": 10,
            "max": 500,
            "default": 80,
            "conditional": {
                "key": "enable_text_limit",
                "value": true
            }
        },

        {
            "key": "group",
            "label": "Layout",
            "type": "group",
            "help": "Set text alignment (left, center, right)."
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": [
                "left",
                "center",
                "right"
            ],
            "default": "left"
        },
        
        {
            "key": "group",
            "label": "Spacing",
            "type": "group",
            "help": "Adjust inner padding around the text block."
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "padding_left",
            "label": "Padding Left",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "padding_right",
            "label": "Padding Right",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        }
    ]
}

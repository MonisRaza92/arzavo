{
    "type": "heading",
    "name": "Heading",
    "icon": "fa-text-size",
    "order": 1,
    "category": "Basic",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "group",
            "label": "Content",
            "type": "group"
        },
        {
            "key": "text",
            "label": "Heading Text",
            "type": "richtext",
            "default": "Your Amazing Heading",
            "placeholder": "Enter your heading here"
        },
        {
            "key": "heading_type",
            "label": "Heading Type",
            "type": "select",
            "options": [
                "heading-1",
                "heading-2",
                "heading-3",
                "heading-4",
                "heading-5",
                "heading-6"
            ],
            "default": "heading-2"
        },
        {
            "key": "group",
            "label": "Layout",
            "type": "group"
        },
        {
            "key": "desktop_width_type",
            "label": "Heading Width",
            "type": "radio",
            "options": [
                "auto",
                "full",
                "custom"
            ],
            "default": "auto"
        },
        {
            "key": "desktop_width",
            "label": "Desktop Custom Width",
            "type": "range",
            "default": 100,
            "min": 10,
            "max": 100,
            "conditional": {
                "field": "desktop_width_type",
                "value": "custom"
            }
        },
        {
            "key": "alignment",
            "label": "Desktop Alignment",
            "type": "radio",
            "options": [
                "left",
                "center",
                "right"
            ],
            "default": "left",
            "conditional": {
                "field": "desktop_width_type",
                "value": [
                    "full",
                    "custom"
                ],
                "operator": "in"
            }
        },
        {
            "key": "mobile_alignment",
            "label": "Mobile Alignment",
            "type": "radio",
            "options": [
                "left",
                "center",
                "right"
            ],
            "default": "left"
        },
        {
            "key": "group",
            "label": "Spacing",
            "type": "group"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "margin_left",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "margin_right",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "group",
            "label": "Padding",
            "type": "group"
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "padding_left",
            "label": "Padding Left",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "padding_right",
            "label": "Padding Right",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        }
    ]
}
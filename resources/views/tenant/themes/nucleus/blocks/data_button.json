{
    "view": "data_button",
    "name": "Button",
    "icon": "fa-arrow-pointer",
    "order": 3,
    "category": "Basic",
    "max_blocks": 0,
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Content"
        },
        {
            "key": "text",
            "label": "Button Text",
            "type": "text",
            "default": "Click Here"
        },
        {
            "key": "position",
            "label": "Position",
            "type": "select",
            "options": [
                "left",
                "right",
                "space-between",
                "center"
            ],
            "default": "space-between"
        },
        {
            "key": "gap",
            "label": "Gap",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 8,
            "help": "Adjust the gap between text and arrow.",
            "conditional": {
                "field": "position",
                "operator": "!=",
                "value": "space-between"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Spacing"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 120,
            "default": 0
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 120,
            "default": 0
        },
        {
            "key": "margin_left",
            "label": "Margin Left",
            "type": "range",
            "min": 0,
            "max": 120,
            "default": 0
        },
        {
            "key": "margin_right",
            "label": "Margin Right",
            "type": "range",
            "min": 0,
            "max": 120,
            "default": 0
        },
        {
            "key": "group",
            "type": "group",
            "label": "Visibility"
        },
        {
            "key": "hide_desktop",
            "label": "Hide this button on Desktop",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "hide_mobile",
            "label": "Hide this button on Mobile",
            "type": "switch",
            "default": "0"
        }
    ]
}
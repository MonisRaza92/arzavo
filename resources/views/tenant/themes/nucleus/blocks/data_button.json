{
    "type": "data_button",
    "name": "Button",
    "icon": "fa-arrow-pointer",
    "order": 3,
    "category": "Basic",
    "max_blocks": 0,
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Content"
        },
        {
            "key": "text",
            "label": "Button Text",
            "type": "text",
            "default": "Click Here"
        },
        {
            "key": "url",
            "label": "Button URL",
            "type": "url",
            "default": "#"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Type & Icon"
        },
        {
            "key": "button_type",
            "label": "Button Type",
            "type": "radio",
            "options": [
                "primary",
                "secondary",
                "link"
            ],
            "default": "link"
        },
        {
            "key": "show_icon",
            "label": "Show Icon",
            "type": "switch",
            "default": 1
        },
        {
            "key": "icon",
            "label": "Icon",
            "type": "icon",
            "default": "arrow-right",
            "conditional": {
                "field": "show_icon",
                "value": "1"
            }
        },
        {
            "key": "icon_position",
            "label": "Icon Position",
            "type": "radio",
            "options": [
                "left",
                "right"
            ],
            "default": "right",
            "conditional": {
                "field": "show_icon",
                "value": "1"
            }
        },
        {
            "key": "icon_gap",
            "label": "Icon Gap",
            "type": "range",
            "min": 0,
            "max": 40,
            "default": 8,
            "conditional": {
                "field": "show_icon",
                "value": "1"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Layout"
        },
        {
            "key": "width_desktop",
            "label": "Desktop Width",
            "type": "radio",
            "options": [
                "default",
                "full"
            ],
            "default": "default"
        },
        {
            "key": "width_mobile",
            "label": "Mobile Width",
            "type": "radio",
            "options": [
                "default",
                "full"
            ],
            "default": "default"
        },
        {
            "key": "text_align_desktop",
            "label": "Text Align Desktop",
            "type": "radio",
            "options": [
                "left",
                "center",
                "right"
            ],
            "default": "center",
            "conditional": {
                "field": "width_desktop",
                "value": "full"
            }
        },
        {
            "key": "text_align_mobile",
            "label": "Text Align Mobile",
            "type": "radio",
            "options": [
                "left",
                "center",
                "right"
            ],
            "default": "center",
            "conditional": {
                "field": "width_mobile",
                "value": "full"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Link Behavior"
        },
        {
            "key": "open_new_tab",
            "label": "Open in New Tab",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "nofollow",
            "label": "Add rel=nofollow",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Spacing"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 120,
            "default": 0
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 120,
            "default": 0
        },
        {
            "key": "margin_left",
            "label": "Margin Left",
            "type": "range",
            "min": 0,
            "max": 120,
            "default": 0
        },
        {
            "key": "margin_right",
            "label": "Margin Right",
            "type": "range",
            "min": 0,
            "max": 120,
            "default": 0
        },
        {
            "key": "group",
            "type": "group",
            "label": "Visibility"
        },
        {
            "key": "hide_desktop",
            "label": "Hide this button on Desktop",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "hide_mobile",
            "label": "Hide this button on Mobile",
            "type": "switch",
            "default": "0"
        }
    ]
}
{
    "type": "text",
    "name": "Text",
    "icon": "fa-align-left",
    "order": 2,
    "category": "Basic",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "group",
            "label": "Content",
            "type": "group"
        },
        {
            "key": "text",
            "label": "Text Content",
            "type": "richtext",
            "default": "Your text content goes here. You can write multiple lines and it will be displayed beautifully on your website.",
            "placeholder": "Enter your text here"
        },
        {
            "key": "text_type",
            "label": "Text Type",
            "type": "select",
            "options": ["paragraph", "secondary-text"],
            "default": "paragraph"
        },

        {
            "key": "group",
            "label": "Layout",
            "type": "group"
        },
        {
            "key": "desktop_width_type",
            "label": "Heading Width",
            "type": "radio",
            "options": [
                "auto",
                "full",
                "custom"
            ],
            "default": "auto"
        },
        {
            "key": "desktop_width",
            "label": "Desktop Custom Width",
            "type": "range",
            "default": 100,
            "min": 10,
            "max": 100,
            "conditional": {
                "field": "desktop_width_type",
                "value": "custom"
            }
        },
        {
            "key": "alignment",
            "label": "Desktop Alignment",
            "type": "radio",
            "options": [
                "left",
                "center",
                "right"
            ],
            "default": "left"
        },
        {
            "key": "mobile_alignment",
            "label": "Mobile Alignment",
            "type": "radio",
            "options": [
                "left",
                "center",
                "right"
            ],
            "default": "left"
        },
        
        {
            "key": "group",
            "label": "Spacing",
            "type": "group"
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "padding_left",
            "label": "Padding Left",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "padding_right",
            "label": "Padding Right",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        }
    ]
}

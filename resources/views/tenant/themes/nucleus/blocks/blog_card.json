{
  "type": "data_card",
  "name": "Blog Card",
  "icon": "fa-newspaper",
  "order": 1,
  "category": "Content",
  "color_scheme": "scheme_1",
  "max_blocks": 10,
  "moveable": false,
  "deletable": false,
  "toggle": false,
  "allowed_blocks": [
    "data_image",
    "data_title",
    "data_text",
    "data_badge",
    "data_author",
    "data_date",
    "data_button",
    "data_blogs_group"
  ],
  "default_blocks": [
    {
      "type": "data_image",
      "settings": {
        "aspect_ratio": "wide",
        "border_radius": 0
      }
    },
    {
      "type": "data_blogs_group",
      "settings": {
        "alignment": "start",
        "padding_x": 12,
        "padding_y": 16,
        "gap": 12
      },
      "default_blocks": [
        {
          "type": "data_badge",
          "settings": {
            "show_icons": true,
            "border_radius": 20
          }
        },
        {
          "type": "data_title",
          "settings": {
            "heading_type": "h6"
          }
        },
        {
          "type": "data_text",
          "settings": {
            "enable_text_limit": true,
            "text_limit": 100
          }
        },
        {
          "type": "data_blogs_group",
          "settings": {
            "alignment": "center",
            "direction": "horizontal",
            "position": "between",
            "gap": 4
          },
          "default_blocks": [
            "data_author",
            {
              "type": "data_date",
              "settings": {
                "format": "M d, Y",
                "alignment": "right"
              }
            }
          ]
        }
      ]
    }
  ],
  "fields": [
    {
      "key": "group",
      "type": "group",
      "label": "Background",
      "icon": "fa-image"
    },
    {
      "key": "url_type",
      "type": "hidden",
      "default": "blog"
    },
    {
      "key": "scheme_mode",
      "label": "Color Scheme Mode",
      "type": "radio",
      "options": [
        "inherit",
        "separate"
      ],
      "default": "separate"
    },
    {
      "key": "color_scheme",
      "label": "Select Scheme",
      "type": "color_scheme_selector",
      "default": "scheme_1",
      "conditional": {
        "field": "scheme_mode",
        "value": "separate"
      }
    },
    {
      "key": "style_group",
      "type": "group",
      "label": "Card Style",
      "icon": "fa-square"
    },
    {
      "key": "direction",
      "label": "Direction",
      "type": "radio",
      "options": [
        "vertical",
        "horizontal"
      ],
      "default": "vertical"
    },
    {
      "key": "border_width",
      "label": "Border Thickness",
      "type": "range",
      "min": 0,
      "max": 5,
      "default": 1
    },
    {
      "key": "radius",
      "label": "Border Roundness",
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 10
    },
    {
      "key": "spacing_group",
      "type": "group",
      "label": "Spacing",
      "icon": "fa-arrows-alt"
    },
    {
      "key": "padding",
      "label": "Inner Padding",
      "type": "range",
      "min": 0,
      "max": 40,
      "default": 0
    },
    {
      "key": "block_gap",
      "label": "Content Gap",
      "type": "range",
      "min": 0,
      "max": 40,
      "default": 0
    },
    {
      "key": "hover_animation",
      "label": "Hover Animation",
      "type": "switch",
      "default": false
    }
  ]
}
{
    "view": "group",
    "name": "Group",
    "icon": "fa-folder fa-regular",
    "category": "Layout",
    "max_blocks": 20,
    "allowed_blocks": [
        "heading",
        "text",
        "image",
        "button",
        "divider",
        "logo",
        "group",
        "icon",
        "tabs",
        "card",
        "video",
        "spacer",
        "accordion",
        "contact_card",
        "contact_map",
        "contact_form",
        "newsletter_form"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "direction",
            "label": "Desktop Direction",
            "type": "radio",
            "options": [
                "vertical",
                "horizontal"
            ],
            "default": "vertical"
        },
        {
            "key": "mobile_direction",
            "label": "Verticle direction on mobile",
            "type": "switch",
            "default": "1",
            "conditional": {
                "field": "direction",
                "value": "horizontal"
            }
        },
        {
            "key": "mobile_wrap",
            "label": "Wrap items on mobile",
            "type": "switch",
            "default": "0",
            "conditional": {
                "field": "mobile_direction",
                "value": "0"
            }
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": [
                "start",
                "center",
                "end"
            ],
            "default": "start"
        },
        {
            "key": "position",
            "label": "Position",
            "type": "select",
            "options": [
                "start",
                "center",
                "end",
                "between"
            ],
            "default": "start"
        },
        {
            "key": "mobile_alignment",
            "label": "Mobile Alignment",
            "type": "radio",
            "options": [
                "start",
                "center",
                "end"
            ],
            "default": "start",
            "conditional": {
                "field": "direction",
                "value": "horizontal"
            }
        },
        {
            "key": "mobile_position",
            "label": "Mobile Position",
            "type": "select",
            "options": [
                "start",
                "center",
                "end",
                "between"
            ],
            "default": "start",
            "conditional": {
                "field": "direction",
                "value": "horizontal"
            }
        },
        {
            "key": "gap",
            "label": "Gap",
            "type": "range",
            "default": 16,
            "min": 0,
            "max": 120
        },
        {
            "key": "group",
            "type": "group",
            "label": "Size & Positioning",
            "icon": "fa-arrows-left-right"
        },
        {
            "key": "position_type",
            "label": "Position",
            "type": "radio",
            "options": [
                "relative",
                "absolute"
            ],
            "default": "relative"
        },
        {
            "key": "width",
            "label": "Desktop Width",
            "type": "radio",
            "options": [
                "auto",
                "full",
                "custom"
            ],
            "default": "auto",
            "conditional": {
                "field": "position_type",
                "value": "relative"
            }
        },
        {
            "key": "width_unit",
            "label": "Desktop Width Unit",
            "type": "radio",
            "options": [
                "%",
                "px",
                "vw"
            ],
            "default": "%",
            "conditional": [
                {
                    "field": "position_type",
                    "value": "relative"
                },
                {
                    "field": "width",
                    "value": "custom"
                }
            ]
        },
        {
            "key": "max_width",
            "label": "Desktop Width",
            "type": "number",
            "default": 100,
            "conditional": [
                {
                    "field": "position_type",
                    "value": "relative"
                },
                {
                    "field": "width",
                    "value": "custom"
                }
            ]
        },
        {
            "key": "mobile_width",
            "label": "Mobile Width",
            "type": "radio",
            "options": [
                "auto",
                "full",
                "custom"
            ],
            "default": "auto",
            "conditional": {
                "field": "position_type",
                "value": "relative"
            }
        },
        {
            "key": "width_mobile_unit",
            "label": "Mobile Width Unit",
            "type": "radio",
            "options": [
                "%",
                "px",
                "vw"
            ],
            "default": "%",
            "conditional": [
                {
                    "field": "position_type",
                    "value": "relative"
                },
                {
                    "field": "width_mobile",
                    "value": "custom"
                }
            ]
        },
        {
            "key": "max_width_mobile",
            "label": "Mobile Width",
            "type": "number",
            "default": 100,
            "conditional": [
                {
                    "field": "position_type",
                    "value": "relative"
                },
                {
                    "field": "width_mobile",
                    "value": "custom"
                }
            ]
        },
        {
            "key": "height",
            "label": "Desktop Height",
            "type": "radio",
            "options": [
                "auto",
                "full",
                "custom"
            ],
            "default": "auto",
            "conditional": {
                "field": "position_type",
                "value": "relative"
            }
        },
        {
            "key": "height_unit",
            "label": "Desktop Height Unit",
            "type": "radio",
            "options": [
                "px",
                "%",
                "vh"
            ],
            "default": "vh",
            "conditional": [
                {
                    "field": "position_type",
                    "value": "relative"
                },
                {
                    "field": "height",
                    "value": "custom"
                }
            ]
        },
        {
            "key": "custom_height",
            "label": "Desktop Height",
            "type": "number",
            "default": 60,
            "conditional": [
                {
                    "field": "position_type",
                    "value": "relative"
                },
                {
                    "field": "height",
                    "value": "custom"
                }
            ]
        },
        {
            "key": "mobile_height",
            "label": "Mobile Height",
            "type": "radio",
            "options": [
                "auto",
                "full",
                "custom"
            ],
            "default": "auto",
            "conditional": {
                "field": "position_type",
                "value": "relative"
            }
        },
        {
            "key": "height_mobile_unit",
            "label": "Mobile Height Unit",
            "type": "radio",
            "options": [
                "px",
                "%",
                "vh"
            ],
            "default": "vh",
            "conditional": [
                {
                    "field": "position_type",
                    "value": "relative"
                },
                {
                    "field": "mobile_height",
                    "value": "custom"
                }
            ]
        },
        {
            "key": "custom_height_mobile",
            "label": "Mobile Height",
            "type": "number",
            "default": 60,
            "conditional": [
                {
                    "field": "position_type",
                    "value": "relative"
                },
                {
                    "field": "mobile_height",
                    "value": "custom"
                }
            ]
        },
        {
            "key": "abs_width",
            "label": "Width (px)",
            "type": "number",
            "default": 300,
            "conditional": {
                "field": "position_type",
                "operator": "!=",
                "value": "relative"
            }
        },
        {
            "key": "abs_height",
            "label": "Height (px)",
            "type": "number",
            "default": 200,
            "conditional": {
                "field": "position_type",
                "operator": "!=",
                "value": "relative"
            }
        },
        {
            "key": "abs_width_mobile",
            "label": "Mobile Width (px)",
            "type": "number",
            "default": 300,
            "conditional": {
                "field": "position_type",
                "operator": "!=",
                "value": "relative"
            }
        },
        {
            "key": "abs_height_mobile",
            "label": "Mobile Height (px)",
            "type": "number",
            "default": 200,
            "conditional": {
                "field": "position_type",
                "operator": "!=",
                "value": "relative"
            }
        },
        {
            "key": "vertical_offset",
            "label": "Vertical Position (Desktop)",
            "type": "number",
            "default": 0,
            "conditional": {
                "field": "position_type",
                "operator": "!=",
                "value": "relative"
            }
        },
        {
            "key": "horizontal_offset",
            "label": "Horizontal Position (Desktop)",
            "type": "number",
            "default": 0,
            "conditional": {
                "field": "position_type",
                "operator": "!=",
                "value": "relative"
            }
        },
        {
            "key": "vertical_offset_mobile",
            "label": "Vertical Position (Mobile)",
            "type": "number",
            "default": 0,
            "conditional": {
                "field": "position_type",
                "operator": "!=",
                "value": "relative"
            }
        },
        {
            "key": "horizontal_offset_mobile",
            "label": "Horizontal Position (Mobile)",
            "type": "number",
            "default": 0,
            "conditional": {
                "field": "position_type",
                "operator": "!=",
                "value": "relative"
            }
        },
        {
            "key": "z_index",
            "label": "Z Index",
            "type": "range",
            "default": 1,
            "min": 1,
            "max": 100
        },
        {
            "key": "group",
            "type": "group",
            "label": "Background",
            "icon": "fa-image"
        },
        {
            "key": "scheme_mode",
            "label": "Color Scheme",
            "type": "radio",
            "options": [
                "inherit",
                "separate"
            ],
            "default": "inherit"
        },
        {
            "key": "color_scheme",
            "label": "Select Scheme",
            "type": "color_scheme_selector",
            "conditional": {
                "field": "scheme_mode",
                "value": "separate"
            }
        },
        {
            "key": "background_type",
            "type": "radio",
            "label": "Background",
            "options": [
                "none",
                "color",
                "media"
            ],
            "default": "none"
        },
        {
            "key": "media_type",
            "type": "radio",
            "label": "Media Type",
            "options": [
                "image",
                "video"
            ],
            "default": "image",
            "conditional": {
                "field": "background_type",
                "value": "media"
            }
        },
        {
            "key": "background_image",
            "type": "image",
            "label": "Background Image",
            "conditional": [
                {
                    "field": "background_type",
                    "value": "media"
                },
                {
                    "field": "media_type",
                    "value": "image"
                }
            ]
        },
        {
            "key": "background_video",
            "type": "video",
            "label": "Background Video",
            "conditional": [
                {
                    "field": "background_type",
                    "value": "media"
                },
                {
                    "field": "media_type",
                    "value": "video"
                }
            ]
        },
        {
            "key": "background_attachment",
            "type": "radio",
            "label": "Image Scroll",
            "options": [
                "scroll",
                "fixed"
            ],
            "default": "scroll",
            "conditional": [
                {
                    "field": "background_type",
                    "value": "media"
                },
                {
                    "field": "media_type",
                    "value": "image"
                }
            ]
        },
        {
            "key": "background_blur",
            "type": "switch",
            "label": "Blur Background",
            "default": "0",
            "conditional": {
                "field": "background_type",
                "operator": "!=",
                "value": "color"
            }
        },
        {
            "key": "background_blur_intensity",
            "type": "range",
            "label": "Blur Intensity",
            "default": 8,
            "min": 0,
            "max": 30,
            "conditional": [
                {
                    "field": "background_blur",
                    "value": "1"
                },
                {
                    "field": "background_type",
                    "operator": "!=",
                    "value": "color"
                }
            ]
        },
        {
            "key": "group",
            "type": "group",
            "label": "Overlay",
            "icon": "fa-square-plus",
            "conditional": {
                "field": "background_type",
                "operator": "!=",
                "value": "color"
            }
        },
        {
            "key": "background_overlay",
            "type": "switch",
            "label": "Enable Overlay",
            "default": "0",
            "conditional": {
                "field": "background_type",
                "operator": "!=",
                "value": "color"
            }
        },
        {
            "key": "overlay_color",
            "type": "color",
            "label": "Overlay Color",
            "default": "#000000",
            "conditional": [
                {
                    "field": "background_overlay",
                    "value": "1"
                },
                {
                    "field": "background_type",
                    "operator": "!=",
                    "value": "color"
                }
            ]
        },
        {
            "key": "overlay_opacity",
            "type": "range",
            "label": "Overlay Opacity",
            "default": 50,
            "min": 0,
            "max": 100,
            "conditional": [
                {
                    "field": "background_overlay",
                    "value": "1"
                },
                {
                    "field": "background_type",
                    "operator": "!=",
                    "value": "color"
                }
            ]
        },
        {
            "key": "group",
            "type": "group",
            "label": "Border"
        },
        {
            "key": "border_width",
            "label": "Border Width",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 20
        },
        {
            "key": "border_radius",
            "label": "Border Radius",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "group",
            "type": "group",
            "label": "Spacing",
            "icon": "fa-arrows-alt-v"
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "padding_left",
            "label": "Padding Left",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "padding_right",
            "label": "Padding Right",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "group",
            "type": "group",
            "label": "Visibility",
            "icon": "fa-eye-slash"
        },
        {
            "key": "hide_desktop",
            "label": "Hide this section on desktop",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "hide_mobile",
            "label": "Hide this section on Mobile",
            "type": "switch",
            "default": "0"
        }
    ]
}
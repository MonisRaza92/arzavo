{
    "type": "data_group",
    "name": "Group",
    "icon": "fa-layer-group",
    "category": "Layout",
    "max_blocks": 25,
    "allowed_blocks": [
        "data_image",
        "data_title",
        "data_text",
        "data_button",
        "data_pricing",
        "data_badge",
        "data_rating",
        "data_author",
        "data_stats",
        "data_actions",
        "data_specs",
        "data_previews",
        "data_highlights",
        "data_description",
        "data_details_group",
        "divider",
        "spacer",
        "data_pills"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Style & Background",
            "help": "Customize the container background color and color scheme."
        },
        {
            "key": "scheme_mode",
            "label": "Color Scheme",
            "type": "radio",
            "options": [
                "inherit",
                "separate"
            ],
            "default": "inherit",
            "help": "Choose 'inherit' to use parent section color scheme or 'separate' to select a custom color scheme."
        },
        {
            "key": "color_scheme",
            "label": "Select Scheme",
            "type": "color_scheme_selector",
            "default": "scheme_2",
            "conditional": {
                "field": "scheme_mode",
                "value": "separate"
            },
            "help": "Select a color scheme preset for this group."
        },
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "help": "Control direction, alignment, content position, block width, and gap spacing."
        },
        {
            "key": "direction",
            "label": "Direction",
            "type": "radio",
            "options": [
                "vertical",
                "horizontal"
            ],
            "default": "vertical",
            "help": "Arrange child elements vertically (stacked) or horizontally (side-by-side)."
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": [
                "start",
                "center",
                "end"
            ],
            "default": "start",
            "help": "Align items along the cross axis (start, center, end)."
        },
        {
            "key": "position",
            "label": "Content Position",
            "type": "select",
            "options": [
                "start",
                "center",
                "end",
                "between"
            ],
            "default": "start",
            "help": "Set content distribution and alignment along the main axis."
        },
        {
            "key": "block_width",
            "label": "Block Width (%)",
            "type": "range",
            "default": 100,
            "min": 0,
            "max": 100,
            "help": "Set container width percentage relative to parent section."
        },
        {
            "key": "gap",
            "label": "Gap",
            "type": "range",
            "default": 16,
            "min": 0,
            "max": 80,
            "help": "Adjust space between items inside this group."
        },
        {
            "key": "border",
            "label": "Border Width",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 10,
            "help": "Set border width for this group."
        },
        {
            "key": "radius",
            "label": "Border Radius",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 200,
            "help": "Set border radius for this group."
        },
        {
            "key": "group",
            "type": "group",
            "label": "Padding",
            "help": "Control inner padding around this group container."
        },
        {
            "key": "padding",
            "label": "Padding",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 200,
            "help": "Set inner padding space around all child blocks."
        }
    ]
}
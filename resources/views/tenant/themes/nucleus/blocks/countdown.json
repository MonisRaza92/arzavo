{
    "type": "countdown",
    "name": "Countdown Timer",
    "icon": "fa-clock",
    "order": 10,
    "category": "Interactive",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "target_date",
            "label": "Target Date",
            "type": "datetime-local",
            "default": ""
        },
        {
            "key": "countdown_title",
            "label": "Countdown Title",
            "type": "text",
            "default": "Coming Soon",
            "placeholder": "Enter countdown title"
        },
        {
            "key": "show_title",
            "label": "Show Title",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "yes"
        },
        {
            "key": "title_position",
            "label": "Title Position",
            "type": "radio",
            "options": ["top", "bottom"],
            "default": "top"
        },
        {
            "key": "display_format",
            "label": "Display Format",
            "type": "select",
            "options": ["days_hours_minutes_seconds", "hours_minutes_seconds", "days_hours", "compact"],
            "default": "days_hours_minutes_seconds"
        },
        {
            "key": "layout_style",
            "label": "Layout Style",
            "type": "select",
            "options": ["boxes", "circles", "minimal", "digital"],
            "default": "boxes"
        },
        {
            "key": "size",
            "label": "Size",
            "type": "select",
            "options": ["small", "medium", "large"],
            "default": "medium"
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "select",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "mobile_alignment",
            "label": "Mobile Alignment",
            "type": "select",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "show_labels",
            "label": "Show Labels",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "yes"
        },
        {
            "key": "separator_style",
            "label": "Separator Style",
            "type": "select",
            "options": ["none", "colon", "dots", "line"],
            "default": "colon"
        },
        {
            "key": "animation",
            "label": "Animation",
            "type": "select",
            "options": ["none", "flip", "slide", "fade"],
            "default": "flip"
        },
        {
            "key": "expired_message",
            "label": "Expired Message",
            "type": "text",
            "default": "Event has started!",
            "placeholder": "Message to show when countdown ends"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": 0
        }
    ]
}
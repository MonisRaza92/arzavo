{
  "type": "data_card",
  "name": "Book Card",
  "icon": "fa-book",
  "order": 1,
  "category": "Content",
  "color_scheme": "scheme_1",
  "max_blocks": 10,
  "moveable": false,
  "deletable": false,
  "toggle": false,
  "allowed_blocks": [
    "data_image",
    "data_title",
    "data_text",
    "data_badge",
    "data_rating",
    "data_pricing",
    "data_author",
    "data_button",
    "data_group"
  ],
  "default_blocks": [
    {
      "type": "data_image",
      "settings": {
        "aspect_ratio": "wide"
      }
    },
    {
      "type": "data_group",
      "settings": {
        "alignment": "start",
        "padding": 12,
        "gap": 12
      },
      "default_blocks": [
        {
          "type": "data_title",
          "settings": {
            "heading_type": "h6"
          }
        },
        {
          "type": "data_text",
          "settings": {
            "enable_text_limit": true,
            "text_limit": 80
          }
        },
        "data_badge",
        {
          "type": "data_group",
          "settings": {
            "alignment": "center",
            "direction": "horizontal",
            "position": "between",
            "padding": 0,
            "gap": 4
          },
          "default_blocks": [
            "data_pricing",
            "data_rating"
          ]
        }
      ]
    }
  ],
  "fields": [
    {
      "key": "group",
      "type": "group",
      "label": "Background",
      "icon": "fa-image"
    },
    {
      "key": "url_type",
      "type": "hidden",
      "default": "book"
    },
    {
      "key": "scheme_mode",
      "label": "Color Scheme Mode",
      "type": "radio",
      "options": [
        "inherit",
        "separate"
      ],
      "default": "separate"
    },
    {
      "key": "color_scheme",
      "label": "Select Scheme",
      "type": "color_scheme_selector",
      "default": "scheme_1",
      "conditional": {
        "field": "scheme_mode",
        "value": "separate"
      }
    },
    {
      "key": "style_group",
      "type": "group",
      "label": "Card Style",
      "icon": "fa-square"
    },
    {
      "key": "direction",
      "label": "Direction",
      "type": "radio",
      "options": [
        "vertical",
        "horizontal"
      ],
      "default": "vertical"
    },
    {
      "key": "border_width",
      "label": "Border Thickness",
      "type": "range",
      "min": 0,
      "max": 5,
      "default": 2
    },
    {
      "key": "radius",
      "label": "Border Roundness",
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 10
    },
    {
      "key": "spacing_group",
      "type": "group",
      "label": "Spacing",
      "icon": "fa-arrows-alt"
    },
    {
      "key": "padding",
      "label": "Inner Padding",
      "type": "range",
      "min": 0,
      "max": 40,
      "default": 0
    },
    {
      "key": "block_gap",
      "label": "Content Gap",
      "type": "range",
      "min": 0,
      "max": 40,
      "default": 0
    },
    {
      "key": "hover_animation",
      "label": "Hover Animation",
      "type": "switch",
      "default": true
    }
  ]
}
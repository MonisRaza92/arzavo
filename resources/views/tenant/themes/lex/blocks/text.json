{
    "type": "text",
    "name": "Text",
    "icon": "fa-align-left",
    "order": 2,
    "category": "Basic",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "group",
            "label": "Content",

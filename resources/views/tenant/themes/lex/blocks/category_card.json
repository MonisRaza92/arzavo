{
  "type": "data_card",
  "name": "Category Card",
  "icon": "fa-address-card",
  "order": 1,
  "category": "Content",
  "max_blocks": 5,
  "moveable": false,
  "deletable": false,
  "toggle": false,
  "allowed_blocks": [
    "data_image",
    "data_title",
    "data_classes",

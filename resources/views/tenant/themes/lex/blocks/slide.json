{
    "type": "slide",
    "name": "Slide",
    "icon": "fa-images",
    "category": "Basic",
    "color_scheme": "scheme_1",
    "max_blocks": 6,
    "allowed_blocks": [
        "heading",
        "text",
        "button",
        "group",
        "image",
        "video"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Media",
            "icon": "fa-image"
        },
        {
            "key": "media_type",
            "type": "radio",
            "label": "Media Type",
            "options": [
                "image",
                "video"
            ],
            "default": "image"
        },
        {
            "key": "image",
            "type": "image",
            "label": "Image",
            "conditional": {
                "field": "media_type",
                "value": "image"
            }
        },
        {
            "key": "video",
            "type": "video",
            "label": "Video",
            "conditional": {
                "field": "media_type",
                "value": "video"
            }
        },
        {
            "key": "media_aspect_ratio",
            "type": "select",
            "label": "Aspect Ratio",
            "options": [
                "auto",
                "21:9",
                "16:9",
                "4:3",
                "1:1",
                "9:16"
            ],
            "default": "21:9"
        },
        {
            "key": "media_stack",
            "type": "switch",
            "label": "Stack Media",
            "default": "0"
        },
        {
            "key": "image_link",
            "type": "link",
            "label": "Block Link"
        },
        {
            "key": "open_new_tab",
            "type": "switch",
            "label": "Open in new tab",
            "default": "0",
            "conditional": {
                "field": "image_link",
                "operator": "!=",
                "value": ""
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Overlay",
            "icon": "fa-square-plus",
            "conditional": {
                "field": "media_stack",
                "value": "0"
            }
        },
        {
            "key": "overlay_enable",
            "type": "switch",
            "label": "Enable Overlay",
            "default": "0",
            "conditional": {
                "field": "media_stack",
                "value": "0"
            }
        },
        {
            "key": "overlay_color",
            "type": "color",
            "label": "Overlay Color",
            "default": "#ffffff",
            "conditional": [
                {
                    "field": "overlay_enable",
                    "value": "1"
                },
                {
                    "field": "media_stack",
                    "value": "0"
                }
            ]
        },
        {
            "key": "overlay_opacity",
            "type": "range",
            "label": "Overlay Opacity",
            "default": 50,
            "min": 0,
            "max": 100,
            "conditional": [
                {
                    "field": "overlay_enable",
                    "value": "1"
                },
                {
                    "field": "media_stack",
                    "value": "0"
                }
            ]
        },
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "direction",
            "type": "radio",
            "label": "Direction",
            "options": [
                "vertical",
                "horizontal"
            ],
            "default": "vertical"
        },
        {
            "key": "mobile_direction",
            "type": "switch",
            "label": "Vertical direction on mobile",
            "default": "1",
            "conditional": {
                "field": "direction",
                "value": "horizontal"
            }
        },
        {
            "key": "alignment",
            "type": "radio",
            "label": "Alignment",
            "options": [
                "start",
                "center",
                "end"
            ],
            "default": "center"
        },
        {
            "key": "position",
            "type": "select",
            "label": "Position",
            "options": [
                "start",
                "center",
                "end",
                "between"
            ],
            "default": "center"
        },
        {
            "key": "mobile_alignment",
            "type": "radio",
            "label": "Mobile Alignment",
            "options": [
                "start",
                "center",
                "end"
            ],
            "default": "center",
            "conditional": [
                {
                    "field": "direction",
                    "value": "horizontal"
                },
                {
                    "field": "mobile_direction",
                    "value": "1"
                }
            ]
        },
        {
            "key": "mobile_position",
            "type": "select",
            "label": "Mobile Position",
            "options": [
                "start",
                "center",
                "end",
                "between"
            ],
            "default": "center",
            "conditional": [
                {
                    "field": "direction",
                    "value": "horizontal"
                },
                {
                    "field": "mobile_direction",
                    "value": "1"
                }
            ]
        },
        {
            "key": "gap",
            "type": "range",
            "label": "Gap",
            "default": 16,
            "min": 0,
            "max": 120
        },
        {
            "key": "group",
            "type": "group",
            "label": "Color Scheme",
            "icon": "fa-palette"
        },
        {
            "key": "scheme_mode",
            "type": "radio",
            "label": "Color Scheme",
            "options": [
                "inherit",
                "separate"
            ],
            "default": "inherit"
        },
        {
            "key": "color_scheme",
            "type": "color_scheme_selector",
            "label": "Select Scheme",
            "conditional": {
                "field": "scheme_mode",
                "value": "separate"
            }
        },
        {
            "key": "group",
            "type": "group",
            "label": "Spacing"
        },
        {
            "key": "padding_top",
            "type": "range",
            "label": "Padding Top",
            "default": "16",
            "min": 0,
            "max": 200
        },
        {
            "key": "padding_bottom",
            "type": "range",
            "label": "Padding Bottom",
            "default": "16",
            "min": 0,
            "max": 200
        },
        {
            "key": "padding_left",
            "type": "range",
            "label": "Padding Left",
            "default": "0",
            "min": 0,
            "max": 200
        },
        {
            "key": "padding_right",
            "type": "range",
            "label": "Padding Right",
            "default": "0",
            "min": 0,
            "max": 200
        }
    ]
}

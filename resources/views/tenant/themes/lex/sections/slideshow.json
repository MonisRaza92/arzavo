{
    "type": "slideshow",
    "name": "Slideshow: Images",
    "icon": "fa-images",
    "order": 5,
    "category": "Banners",
    "color_scheme": "scheme_1",
    "max_blocks": 10,
    "allowed_blocks": [
        "slide"
    ],
    "default_blocks": [
        "slide",
        "slide",
        "slide"
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Background",
            "icon": "fa-layer-group"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Size & Width"
        },
        {
            "key": "content_width",
            "label": "Content Width",
            "type": "radio",
            "options": [
                "container",
                "full"
            ],
            "default": "full"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Slider Behavior",
            "icon": "fa-sliders"
        },
        {
            "key": "autoplay",
            "label": "Automatically change slides",
            "type": "switch",
            "default": "1",
            "text": "Automatically change slides"
        },
        {
            "key": "autoplay_delay",
            "label": "Autoplay Delay (s)",
            "type": "range",
            "default": "3",
            "min": 1,
            "max": 10,
            "conditional": {
                "field": "autoplay",
                "value": "1"
            }
        },
        {
            "key": "show_arrows",
            "label": "Navigation Arrows",
            "type": "switch",
            "default": "1",
            "text": "Show previous / next arrows"
        },
        {
            "key": "show_dots",
            "label": "Pagination Dots indicators",
            "type": "switch",
            "default": "1",
            "text": "Show slide indicators"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Style"
        },
        {
            "key": "border_width",
            "label": "Border Width",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "border_radius",
            "label": "Border Radius",
            "type": "range",
            "min": 0,
            "max": 100,
            "default": "0"
        },
        {
            "key": "group",
            "type": "group",
            "label": "Spacing"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom ",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "group",
            "type": "group",
            "label": "Visibility"
        },
        {
            "key": "hide_desktop",
            "label": "Hide this section on desktop",
            "type": "switch",
            "default": "0"
        },
        {
            "key": "hide_mobile",
            "label": "Hide this section on Mobile",
            "type": "switch",
            "default": "0"
        }
    ]
}

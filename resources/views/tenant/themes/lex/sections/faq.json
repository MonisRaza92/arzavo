{
    "type": "faq",
    "name": "FAQ",
    "icon": "fa-quote-left",
    "category": "Trust Building",
    "order": 11,
    "color_scheme": "scheme_1",
    "max_blocks": 20,
    "allowed_blocks": [
        "header",
        "heading",
        "text",
        "accordion"
    ],
    "default_blocks": [
        {
            "type": "header",
            "settings": {
                "alignment": "center",
                "gap": 8,
                "padding_bottom": 0
            },
            "default_blocks": [
                {
                    "type": "heading",
                    "settings": {
                        "text": "Frequently Asked Questions",
                        "heading_type": "heading-4",
                        "alignment": "center"
                    }
                },
                {
                    "type": "text",
                    "settings": {
                        "text": "Find answers to common questions about our platform and services.",
                        "alignment": "center"
                    }
                }
            ]
        },
        {
            "type": "accordion",
            "settings": {
                "question": "What is included in the free plan?",
                "answer": "Our free plan includes basic student management, attendance tracking, and simple reporting for up to 50 students."
            }
        },
        {
            "type": "accordion",
            "settings": {
                "question": "Can I upgrade my plan later?",
                "answer": "Yes, you can upgrade your plan at any time. Your data will be preserved and all new features will be available immediately."
            }
        },
        {
            "type": "accordion",
            "settings": {
                "question": "Is my data secure?",
                "answer": "Absolutely. We use enterprise-grade encryption and follow industry best practices for data security and privacy."
            }
        },
        {
            "type": "accordion",
            "settings": {
                "question": "Do you offer customer support?",
                "answer": "We provide 24/7 customer support via email, phone, and live chat. Our team is always ready to help you with any issues."
            }
        },
        {
            "type": "accordion",
            "settings": {
                "question": "Can I cancel my subscription?",
                "answer": "You can cancel your subscription at any time with no penalties. We also offer a 30-day money-back guarantee."
            }
        }
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "faq_columns",
            "label": "Columns",
            "type": "radio",
            "options": ["1", "2"],
            "default": "1"
        },
        {
            "key": "gap",
            "label": "Items Gap",
            "type": "range",
            "default": 12,
            "min": 0,
            "max": 40
        },
        {
            "key": "max_width",
            "label": "Content Max Width",
            "type": "range",
            "default": 800,
            "min": 400,
            "max": 1400
        },
        {
            "preset": "section_bg_type_fields"
        },
        {
            "preset": "bg_overlay_fields"
        },
        {
            "preset": "section_spacing_fields"
        },
        {
            "preset": "section_mobile_spacing_fields"
        },
        {
            "preset": "visibility_fields"
        }
    ]
}


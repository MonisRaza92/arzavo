{
    "type": "contact_form",
    "name": "Contact Form",
    "icon": "fa-envelope",
    "category": "Storytelling",
    "order": 12,
    "color_scheme": "scheme_1",
    "max_blocks": 10,
    "allowed_blocks": [
        "header",
        "heading",
        "text",
        "icon",
        "group",
        "button",
        "spacer",
        "divider"
    ],
    "default_blocks": [
        {
            "type": "header",
            "settings": {
                "alignment": "start",
                "gap": 8,
                "padding_bottom": 0
            },
            "default_blocks": [
                {
                    "type": "heading",
                    "settings": {
                        "text": "Get In Touch",
                        "heading_type": "heading-4",
                        "alignment": "left"
                    }
                },
                {
                    "type": "text",
                    "settings": {
                        "text": "Have questions? We'd love to hear from you. Send us a message and we'll respond as soon as possible.",
                        "alignment": "left"
                    }
                }
            ]
        }
    ],
    "fields": [
        {
            "key": "group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "layout_style",
            "label": "Layout",
            "type": "radio",
            "options": ["stacked", "split"],
            "default": "split"
        },
        {
            "key": "form_position",
            "label": "Form Position",
            "type": "radio",
            "options": ["left", "right"],
            "default": "right",
            "conditional": {
                "field": "layout_style",
                "value": "split"
            }
        },
        {
            "key": "gap",
            "label": "Content Gap",
            "type": "range",
            "default": 48,
            "min": 0,
            "max": 120
        },
        {
            "key": "group",
            "type": "group",
            "label": "Form Fields",
            "icon": "fa-input-text"
        },
        {
            "key": "show_phone",
            "label": "Show Phone Field",
            "type": "switch",
            "default": "1"
        },
        {
            "key": "show_subject",
            "label": "Show Subject Field",
            "type": "switch",
            "default": "1"
        },
        {
            "key": "button_text",
            "label": "Submit Button Text",
            "type": "text",
            "default": "Send Message"
        },
        {
            "key": "success_message",
            "label": "Success Message",
            "type": "text",
            "default": "Thank you! Your message has been sent successfully."
        },
        {
            "preset": "section_bg_type_fields"
        },
        {
            "preset": "bg_overlay_fields"
        },
        {
            "preset": "section_spacing"
        },
        {
            "preset": "visibility_fields"
        }
    ]
}

{
    "type": "dataset_container",
    "name": "Classes: Grid",
    "icon": "fa-layer-group",
    "category": "Classes",
    "color_scheme": "scheme_1",
    "max_blocks": 20,
    "allowed_blocks": [
        "header",
        "heading",
        "text",
        "button",
        "class_card"
    ],
    "default_blocks": [
        {
            "type": "header",
            "settings": {
                "alignment": "start",
                "gap": 8
            },
            "default_blocks": [
                {
                    "type": "heading",
                    "settings": {
                        "text": "Our Classes",
                        "heading_type": "heading-5",
                        "alignment": "left",
                        "mobile_alignment": "left"
                    }
                },
                {
                    "type": "text",
                    "settings": {
                        "text": "Explore courses designed to help students succeed academically and professionally.",
                        "alignment": "left",
                        "mobile_alignment": "left"
                    }
                }
            ]
        },
        "class_card"
    ],
    "fields": [
        {
            "key": "layout_group",
            "type": "group",
            "label": "Layout",
            "icon": "fa-layer-group"
        },
        {
            "key": "dataset_source",
            "type": "hidden",
            "default": "classes"
        },
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "layout_style",
            "label": "Layout Style",
            "type": "radio",
            "options": [
                "grid",
                "carousel"
            ],
            "default": "grid"
        },
        {
            "key": "gap",
            "label": "Items Gap",
            "type": "range",
            "default": 24,
            "min": 0,
            "max": 80
        },
        {
            "key": "show_limit",
            "label": "Items Limit",
            "type": "range",
            "default": 6,
            "min": 1,
            "max": 24
        },
        {
            "key": "grid_group",
            "type": "group",
            "label": "Grid Settings",
            "conditional": {
                "field": "layout_style",
                "value": "grid"
            }
        },
        {
            "key": "columns",
            "label": "Desktop Columns",
            "type": "range",
            "min": 2,
            "max": 10,
            "default": 4,
            "conditional": {
                "field": "layout_style",
                "value": "grid"
            }
        },
        {
            "key": "mobile_columns",
            "label": "Mobile Columns",
            "type": "range",
            "min": 1,
            "max": 3,
            "default": 2,
            "conditional": {
                "field": "layout_style",
                "value": "grid"
            }
        },
        {
            "key": "carousel_group",
            "type": "group",
            "label": "Carousel Settings",
            "conditional": {
                "field": "layout_style",
                "value": "carousel"
            }
        },
        {
            "key": "slides_visible",
            "label": "Desktop Cards",
            "type": "range",
            "min": 1,
            "max": 10,
            "default": 4,
            "conditional": {
                "field": "layout_style",
                "value": "carousel"
            }
        },
        {
            "key": "slides_visible_mobile",
            "label": "Mobile Cards",
            "type": "range",
            "min": 1,
            "max": 4,
            "default": 2,
            "conditional": {
                "field": "layout_style",
                "value": "carousel"
            }
        },
        {
            "key": "show_arrows",
            "label": "Show Arrows",
            "type": "switch",
            "default": "1",
            "conditional": {
                "field": "layout_style",
                "value": "carousel"
            }
        },
        {
            "key": "show_dots",
            "label": "Show Dots",
            "type": "switch",
            "default": "0",
            "conditional": {
                "field": "layout_style",
                "value": "carousel"
            }
        },
        {
            "key": "spacing_group",
            "type": "group",
            "label": "Spacing",
            "icon": "fa-arrows-alt-v"
        },
        {
            "key": "padding_top",
            "type": "range",
            "label": "Padding Top",
            "default": 42,
            "min": 0,
            "max": 200
        },
        {
            "key": "padding_bottom",
            "type": "range",
            "label": "Padding Bottom",
            "default": 16,
            "min": 0,
            "max": 200
        },
        {
            "key": "margin_top",
            "type": "range",
            "label": "Margin Top",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "margin_bottom",
            "type": "range",
            "label": "Margin Bottom",
            "default": 0,
            "min": 0,
            "max": 200
        },
        {
            "key": "visibility_group",
            "type": "group",
            "label": "Visibility",
            "icon": "fa-eye-slash"
        },
        {
            "key": "hide_desktop",
            "type": "switch",
            "label": "Hide Section on Desktop",
            "default": "0"
        },
        {
            "key": "hide_mobile",
            "type": "switch",
            "label": "Hide Section on Mobile",
            "default": "0"
        }
    ]
}
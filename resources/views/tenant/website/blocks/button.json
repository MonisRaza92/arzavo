{
    "type": "button",
    "name": "Button",
    "icon": "fa-arrow-pointer",
    "order": 3,
    "category": "Basic",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "text",
            "label": "Button Text",
            "type": "text",
            "default": "Click Here",
            "placeholder": "Enter button text"
        },
        {
            "key": "url",
            "label": "Button URL",
            "type": "link",
            "default": "#",
            "placeholder": "https://"
        },
        {
            "key": "icon",
            "label": "Button Icon",
            "type": "icon",
            "default": "none"
        },
        {
            "key": "icon_position",
            "label": "Icon Position",
            "type": "radio",
            "options": ["left", "right"],
            "default": "right"
        },
        {
            "key": "icon_gap",
            "label": "Icon Gap (px)",
            "type": "range",
            "default": 4,
            "min": 0,
            "max": 50,
            "help": "Set gap between text and icon in px"
        },
        {
            "key": "type",
            "label": "Button Type",
            "type": "select",
            "options": ["primary", "secondary", "link"],
            "default": "primary"
        },
        {
            "key": "alignment",
            "label": "Text Alignment",
            "type": "radio",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "width_desktop",
            "label": "Button Width (Desktop)",
            "type": "radio",
            "options": ["fit", "full", "custom"],
            "default": "fit"
        },
        {
            "key": "custom_width_desktop",
            "label": "Custom Width (Desktop) %",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "width_desktop",
                "value": "custom"
            }
        },
        {
            "key": "width_mobile",
            "label": "Button Width (Mobile)",
            "type": "radio",
            "options": ["fit", "full", "custom"],
            "default": "full"
        },
        {
            "key": "custom_width_mobile",
            "label": "Custom Width (Mobile) %",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "width_mobile",
                "value": "custom"
            }
        },
        {
            "key": "border",
            "label": "Button Border",
            "type": "radio",
            "options": ["enable", "disable", "custom"],
            "default": "enable"
        },
        {
            "key": "custom_border_width",
            "label": "Custom Border Width",
            "type": "range",
            "default": 1,
            "min": 0,
            "max": 20,
            "conditional": {
                "field": "border",
                "value": "custom"
            }
        },
        {
            "key": "radius",
            "label": "Button Border Radius",
            "type": "radio",
            "options": ["enable", "disable", "custom"],
            "default": "enable"
        },
        {
            "key": "custom_radius_size",
            "label": "Custom Border Radius",
            "type": "range",
            "default": 4,
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "radius",
                "value": "custom"
            }
        },
        {
            "key": "btn_new_tab",
            "label": "Button Link",
            "type": "switch",
            "text": "Turn on to open link in new tab"
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_left",
            "label": "Margin Left",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_right",
            "label": "Margin Right",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        }
    ]
}

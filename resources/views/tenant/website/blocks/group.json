{
    "type": "group",
    "name": "Group",
    "icon": "fa-layer-group",
    "order": 5,
    "category": "Basic",
    "color_scheme_id": null,
    "max_blocks": 5,
    "allowed_blocks": [
        "heading",
        "text",
        "image",
        "button",
        "divider",
        "logo",
        "group",
        "icon"
    ],
    "default_blocks": "",
    "fields": [
        {
            "key": "color_scheme",
            "label": "Color Scheme",
            "type": "radio",
            "options": ["parent", "saparate"],
            "default": "parent"
        },
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector",
            "conditional": {
                "field": "color_scheme",
                "value": "saparate"
            }
        },
        {
            "key": "background_image",
            "label": "Background Image",
            "type": "switch",
            "default": "0",
            "text": "Enable to add a background image"
        },
        {
            "key": "background_image_group",
            "label": "Background Image",
            "type": "image",
            "default": "",
            "conditional": {
                "field": "background_image",
                "value": "1"
            }
        },
        {
            "key": "background_image_overlay",
            "label": "Background Overlay",
            "type": "switch",
            "text": "Overlay for image background",
            "default": "0",
            "conditional": {
                "field": "background_image",
                "value": "1"
            }
        },
        {
            "key": "overlay_color",
            "label": "Overlay Color",
            "type": "color",
            "default": "#000000",
            "conditional": {
                "field": "background_image",
                "value": "1"
            }
        },
        {
            "key": "overlay_opacity",
            "label": "Overlay Opacity",
            "type": "range",
            "default": "50",
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "background_image",
                "value": "1"
            }
        },
        {
            "key": "direction",
            "label": "Direction",
            "type": "radio",
            "options": ["vertical", "horizontal"],
            "default": "vertical"
        },
        {
            "key": "mobile_direction",
            "label": "Mobile Direction",
            "type": "switch",
            "default": "1",
            "text": "Vertical Direction in Mobile Screen",
            "conditional": {
                "field": "direction",
                "value": "horizontal"
            }
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": ["start", "center", "end"],
            "default": "start"
        },
        {
            "key": "position",
            "label": "Position",
            "type": "select",
            "options": ["start", "center", "end", "between"],
            "default": "center"
        },
        {
            "key": "gap",
            "label": "Gap",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "block_position",
            "label": "Block Position",
            "type": "radio",
            "options": ["relative", "absolute"],
            "default": "relative"
        },
        {
            "key": "top",
            "label": "Vertical Position",
            "type": "number",
            "default": "0",
            "min": -200,
            "max": 200,
            "conditional": {
                "field": "block_position",
                "value": "absolute"
            }
        },
        {
            "key": "left",
            "label": "Horizontal Position",
            "type": "number",
            "default": "0",
            "min": -200,
            "max": 200,
            "conditional": {
                "field": "block_position",
                "value": "absolute"
            }
        },
        {
            "key": "width",
            "label": "Width",
            "type": "radio",
            "options": ["auto", "full", "custom"],
            "default": "auto"
        },
        {
            "key": "custom_width",
            "label": "Custom Block Width",
            "type": "range",
            "default": "30",
            "min": 0,
            "max": 100,
            "help": "Set width in percentage",
            "conditional": {
                "field": "width",
                "value": "custom"
            }
        },
        {
            "key": "width_mobile",
            "label": "Width (Mobile)",
            "type": "radio",
            "options": ["auto", "full", "custom"],
            "default": "auto"
        },
        {
            "key": "custom_width_mobile",
            "label": "Custom Block Width",
            "type": "range",
            "default": "30",
            "min": 0,
            "max": 100,
            "help": "Set width in percentage",
            "conditional": {
                "field": "width_mobile",
                "value": "custom"
            }
        },
        {
            "key": "height",
            "label": "Height",
            "type": "radio",
            "options": ["auto", "full", "custom"],
            "default": "auto"
        },
        {
            "key": "custom_height",
            "label": "Custom Height",
            "type": "range",
            "default": "30",
            "min": 0,
            "max": 100,
            "help": "Set height in percentage",
            "conditional": {
                "field": "height",
                "value": "custom"
            }
        },
        {
            "key": "border",
            "label": "Border",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        },
        {
            "key": "custom_border_width",
            "label": "Custom Border",
            "type": "switch",
            "default": "0",
            "text": "enable for custom border width"
        },
        {
            "key": "border_width",
            "label": "Border Width",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "custom_border_width",
                "value": "1"
            }
        },
        {
            "key": "radius",
            "label": "Border Radius",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        },
        {
            "key": "custom_border_radius",
            "label": "Custom Radius",
            "type": "switch",
            "default": "0",
            "text": "enable for custom border Roundness"
        },
        {
            "key": "border_radius",
            "label": "Border Radius",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "custom_border_radius",
                "value": "1"
            }
        },
        {
            "key": "hide_desktop",
            "label": "Hide Desktop",
            "type": "switch",
            "default": "0",
            "text": "Hide Block in Desktop Screen"
        },
        {
            "key": "hide_mobile",
            "label": "Hide Mobile",
            "type": "switch",
            "default": "0",
            "text": "Hide Block in Mobile Screen"
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_right",
            "label": "Padding Right",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_left",
            "label": "Padding Left",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        }
    ]
}

{
    "type": "image",
    "name": "Image",
    "icon": "fa-image",
    "order": 4,
    "category": "Basic",
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "desktop_image_block",
            "label": "Desktop Image",
            "type": "image",
            "default": "",
            "placeholder": "Image for desktop"
        },
        {
            "key": "mobile_image_block",
            "label": "Mobile Image",
            "type": "image",
            "default": "",
            "placeholder": "Image for mobile"
        },
        {
            "key": "image_link",
            "label": "Image Link",
            "type": "link",
            "default": "",
            "placeholder": "https://"
        },
        {
            "key": "link_new_tab",
            "label": "Link Target",
            "type": "switch",
            "text": "Turn on to open link in new tab"
        },
        {
            "key": "alt_text",
            "label": "Alt Text",
            "type": "text",
            "default": "",
            "placeholder": "Enter alt text for the image"
        },
        {
            "key": "image_size",
            "label": "Image Size",
            "type": "radio",
            "default": "full",
            "options": ["full", "custom"]
        },
        {
            "key": "custom_image_size",
            "label": "Custom Image Size",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "image_ratio",
            "label": "Image Ratio",
            "type": "select",
            "options": ["auto", "portrait", "landscape", "square"],
            "default": "auto"
        },
        {
            "key": "image_fit",
            "label": "Image Fit",
            "type": "select",
            "options": ["cover", "contain", "fill", "none", "scale-down"],
            "default": "cover"
        },
        {
            "key": "border",
            "label": "Border",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        },
        {
            "key": "custom_border_width",
            "label": "Custom Border",
            "type": "switch",
            "default": "0",
            "text": "enable for custom border width",
            "conditional": {
                "field": "border",
                "value": "enable"
            }
        },
        {
            "key": "border_width",
            "label": "Border Width",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 10,
            "conditional": [
                {
                    "field": "border",
                    "value": "enable"
                },
                {
                    "field": "custom_border_width",
                    "value": "1"
                }
            ]
        },
        {
            "key": "radius",
            "label": "Border Radius",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        },
        {
            "key": "custom_border_radius",
            "label": "Custom Radius",
            "type": "switch",
            "default": "0",
            "text": "enable for custom border Roundness",
            "conditional": {
                "field": "radius",
                "value": "enable"
            }
        },
        {
            "key": "border_radius",
            "label": "Border Radius",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100,
            "conditional": [
                {
                    "field": "radius",
                    "value": "enable"
                },
                {
                    "field": "custom_border_radius",
                    "value": "1"
                }
            ]
        },
        {
            "key": "hide_desktop",
            "label": "Hide Desktop",
            "type": "switch",
            "default": "0",
            "text": "Hide Image in Desktop Screen"
        },
        {
            "key": "hide_mobile",
            "label": "Hide Mobile",
            "type": "switch",
            "default": "0",
            "text": "Hide Image in Mobile Screen"
        },
        {
            "key": "opacity",
            "label": "Image Opacity %",
            "type": "range",
            "default": 100,
            "min": 0,
            "max": 100
        },
        {
            "key": "image_shadow",
            "label": "Image Shadow",
            "type": "switch",
            "default": "0",
            "text": "Enable for shadow"
        },
        {
            "key": "padding_top",
            "label": "Padding Top (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_left",
            "label": "Padding Left (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_right",
            "label": "Padding Right (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        }
    ]
}

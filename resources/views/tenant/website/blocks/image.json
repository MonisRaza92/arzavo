        {
            "key": "padding_bottom",
            "label": "Padding Bottom (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_left",
            "label": "Padding Left (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_right",
            "label": "Padding Right (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        }

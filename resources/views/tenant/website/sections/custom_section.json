{
    "type": "custom_section",
    "name": "Custom Section",
    "icon": "fa-layer-group",
    "order": 3,
    "category": "layout",
    "color_scheme_id": 1,
    "max_blocks": 5,
    "allowed_blocks": ["heading", "text", "image", "button", "divider", "logo", "group", "icon"],
    "default_blocks": "",
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "background_type",
            "label": "Background Type",
            "type": "radio",
            "options": ["color", "image"],
            "default": "color"
        },
        {
            "key": "background_image_custom_section",
            "label": "Background Image",
            "type": "image",
            "default": ""
        },
        {
            "key": "height",
            "label": "Height",
            "type": "radio",
            "options": ["fit", "full", "custom"],
            "default": "fit"
        },
        {
            "key": "desktop_direction",
            "label": "Desktop Direction",
            "type": "radio",
            "options": ["vertical", "horizontal"],
            "default": "vertical"
        },
        {
            "key": "mobile_direction",
            "label": "Mobile Direction",
            "type": "radio",
            "options": ["vertical", "horizontal"],
            "default": "vertical"
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": ["start", "center", "end"],
            "default": "start"
        },
        {
            "key": "position",
            "label": "Position",
            "type": "radio",
            "options": ["start", "center", "end"],
            "default": "start"
        },
        {
            "key": "section_border",
            "label": "Section Border",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        },
        {
            "key": "gap",
            "label": "Gap",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        }
    ]
}
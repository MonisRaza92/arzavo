            "type": "radio",
            "options": ["enable", "disable"],
            "default": "enable"
        },
        {
            "key": "animation_speed",
            "label": "Animation Speed (seconds)",
            "type": "range",
            "default": 2,
            "min": 1,
            "max": 5
        },
        {
            "key": "number_size",
            "label": "Number Size",
            "type": "select",
            "options": ["small", "medium", "large", "extra-large"],
            "default": "large"
        },
        {
            "key": "alignment",
            "label": "Text Alignment",
            "type": "radio",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "container_width",
            "label": "Container Width",
            "type": "radio",
            "options": ["full", "container"],
            "default": "container"
        },
        {
            "key": "padding_top",
            "label": "Padding Top (px)",
            "type": "range",
            "default": 60,
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom (px)",
            "type": "range",
            "default": 60,
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_top",
            "label": "Margin Top (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100
        },
        {

        {
            "key": "counter_4_number",
            "label": "Counter 4: Number",
            "type": "text",
            "default": "98"
        },
        {
            "key": "counter_4_suffix",
            "label": "Counter 4: Suffix",
            "type": "text",
            "default": "%"
        },
        {
            "key": "counter_4_label",
            "label": "Counter 4: Label",
            "type": "text",
            "default": "Satisfaction Rate"
        },
        {
            "key": "counter_4_icon",
            "label": "Counter 4: Icon",
            "type": "text",
            "options": [
                "fa-users",
                "fa-graduation-cap",
                "fa-book",
                "fa-lightbulb",
                "fa-laptop",
                "fa-chalkboard",
                "fa-microscope",
                "fa-globe",

{
    "type": "counter",
    "name": "Counter Section",
    "icon": "fa-calculator",
    "order": 12,
    "page": ["home", "about", "contact", "product"],
    "category": "Stats",
    "color_scheme_id": 1,
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "counter_style",
            "label": "Counter Style",
            "type": "radio",
            "options": ["minimal", "card"],
            "default": "minimal"
        },
        {
            "key": "columns",
            "label": "Columns (in mobile view)",
            "type": "radio",
            "options": ["1", "2"],
            "default": "1"
        },
        {
            "key": "shadow",
            "label": "Enable Shadow for Card Style",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "enable"
        },
        {
            "key": "radius",
            "label": "Border Radius (for Card Style)",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "enable"
        },
        {
            "key": "counter_1_number",
            "label": "Counter 1: Number",
            "type": "text",
            "default": "500"
        },
        {
            "key": "counter_1_suffix",
            "label": "Counter 1: Suffix",
            "type": "text",
            "default": "+"
        },
        {
            "key": "counter_1_label",
            "label": "Counter 1: Label",
            "type": "text",
            "default": "Happy Clients"
        },
        {
            "key": "counter_1_icon",
            "label": "Counter 1: Icon (Font Awesome)",
            "type": "select",
            "options": [
                "fa-users",
                "fa-graduation-cap",
                "fa-book",
                "fa-lightbulb",
                "fa-laptop",
                "fa-chalkboard",
                "fa-microscope",
                "fa-globe",
                "fa-brain",
                "fa-award",
                "fa-chart-line",
                "fa-project-diagram",
                "fa-trophy",
                "fa-star"
            ],
            "default": "fa-users"
        },
        {
            "key": "counter_2_number",
            "label": "Counter 2: Number",
            "type": "text",
            "default": "1100"
        },
        {
            "key": "counter_2_suffix",
            "label": "Counter 2: Suffix",
            "type": "text",
            "default": "+"
        },
        {
            "key": "counter_2_label",
            "label": "Counter 2: Label",
            "type": "text",
            "default": "Projects Done"
        },
        {
            "key": "counter_2_icon",
            "label": "Counter 2: Icon",
            "type": "select",
            "options": [
                "fa-users",
                "fa-graduation-cap",
                "fa-book",
                "fa-lightbulb",
                "fa-laptop",
                "fa-chalkboard",
                "fa-microscope",
                "fa-globe",
                "fa-brain",
                "fa-award",
                "fa-chart-line",
                "fa-project-diagram",
                "fa-trophy",
                "fa-star"

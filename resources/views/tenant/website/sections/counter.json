        {
            "key": "counter_3_number",
            "label": "Counter 3: Number",
            "type": "text",
            "default": "15"
        },
        {
            "key": "counter_3_suffix",
            "label": "Counter 3: Suffix",
            "type": "text",
            "default": "+"
        },
        {
            "key": "counter_3_label",
            "label": "Counter 3: Label",
            "type": "text",
            "default": "Years Experience"
        },
        {
            "key": "counter_3_icon",
            "label": "Counter 3: Icon",
            "type": "text",
            "options": [
                "fa-users",
                "fa-graduation-cap",
                "fa-book",
                "fa-lightbulb",
                "fa-laptop",
                "fa-chalkboard",
                "fa-microscope",
                "fa-globe",
                "fa-brain",
                "fa-award",
                "fa-chart-line",
                "fa-project-diagram",
                "fa-trophy",
                "fa-star"

{
    "type": "flex_grid_box",
    "name": "Custom Section",
    "icon": "fa-shapes",
    "order": 3,
    "category": "layout",
    "color_scheme_id": 1,
    "max_blocks": 5,
    "allowed_blocks": [
        "heading",
        "text",
        "image",
        "button",
        "divider",
        "logo",
        "group",
        "icon"
    ],
    "default_blocks": "",
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "background_type",
            "label": "Background",
            "type": "radio",
            "options": ["color", "image"],
            "default": "color"
        },
        {
            "key": "background_image_custom_section",
            "label": "Background Image",
            "type": "image",
            "default": "",
            "conditional": {
                "field": "background_type",
                "value": "image"
            }
        },
        {
            "key": "background_image_overlay",
            "label": "Background Overlay",
            "type": "switch",
            "text": "Overlay for image background",
            "default": "0",
            "conditional": {
                "field": "background_type",
                "value": "image"
            }
        },
        {
            "key": "overlay_color",
            "label": "Overlay Color",
            "type": "color",
            "default": "#000000",
            "conditional": {
                "field": "background_type",
                "value": "image"
            }
        },
        {
            "key": "overlay_opacity",
            "label": "Overlay Opacity",
            "type": "range",
            "default": "50",
            "min": 0,
            "max": 100,
            "conditional": {
                "field": "background_type",
                "value": "image"
            }
        },
        {
            "key": "height",
            "label": "Height",
            "type": "radio",
            "options": ["fit", "full"],
            "default": "fit"
        },
        {
            "key": "mobile_height",
            "label": "Mobile Height",
            "type": "switch",
            "text": "Full screen height in Mobile",
            "default": "1",
            "conditional": {
                "field": "height",
                "value": "full"
            }
        },
        {
            "key": "direction",
            "label": "Direction",
            "type": "radio",
            "options": ["vertical", "horizontal"],
            "default": "vertical"
        },
        {
            "key": "mobile_direction",
            "label": "Mobile Direction",
            "type": "switch",
            "default": "1",
            "text": "Vertical Direction in Mobile Screen",
            "conditional": {
                "field": "direction",
                "value": "horizontal"
            }
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": ["start", "center", "end"],
            "default": "center"
        },
        {
            "key": "position",
            "label": "Position",
            "type": "select",
            "options": ["start", "center", "end", "between"],
            "default": "between"
        },
        {
            "key": "gap",
            "label": "Gap",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        }
    ]
}

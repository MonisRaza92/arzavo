{
    "type": "text_over_design",
    "name": "Text Over Design",
    "icon": "fa-compass-drafting",
    "order": 3,
    "page": ["home", "about", "contact"],
    "category": "templates",
    "max_blocks": 10,
    "allowed_blocks": [
        "heading",
        "text",
        "image",
        "button",
        "divider",
        "logo",
        "group",
        "icon"
    ],
    "default_blocks": [
        "heading",
        "text"
    ],
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "section_height",
            "label": "Section Height",
            "type": "radio",
            "options": ["fit", "full", "custom"],
            "default": "fit"
        },
        {
            "key": "cuatom_section_height",
            "label": "Custom Section Height",
            "type": "range",
            "default": "100",
            "min": 50,
            "max": 200
        },
        {
            "key": "design_style",
            "label": "Design Style",
            "type": "select",
            "options": [
                "gradient_mesh",
                "geometric_shapes",
                "wave_patterns",
                "dot_grid",
                "concentric_circles",
                "abstract_lines",
                "mixed"
            ],
            "default": "wave_patterns"
        },
        {
            "key": "design_complexity",
            "label": "Design Complexity",
            "type": "radio",
            "options": ["low", "high"],
            "default": "high"
        },
        {
            "key": "desktop_direction",
            "label": "Desktop Direction",
            "type": "radio",
            "options": ["vertical", "horizontal"],
            "default": "vertical"
        },
        {
            "key": "mobile_direction",
            "label": "Mobile Direction",
            "type": "radio",
            "options": ["vertical", "horizontal"],
            "default": "vertical"
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": ["start", "center", "end"],
            "default": "center"
        },
        {
            "key": "position",
            "label": "Position",
            "type": "radio",
            "options": ["start", "center", "end"],
            "default": "center"
        },
        {
            "key": "section_border",
            "label": "Section Border",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        },
        {
            "key": "gap",
            "label": "Gap",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "default": "32",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "default": "32",
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        }
    ]
}

{
    "type": "custom_code",
    "name": "Custom Code",
    "icon": "fa-code",
    "order": 4,
    "page": ["home", "about", "contact", "product"],
    "category": "layout",
    "color_scheme_id": 1,
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "code_content",
            "label": "Embed Code",
            "type": "textarea",
            "default": "",
            "placeholder": "Paste your HTML, iframe, or JavaScript code here"
        },
        {
            "key": "container_width",
            "label": "Container Width",
            "type": "radio",
            "options": ["full", "container"],
            "default": "container"
        },
        {
            "key": "text_alignment",
            "label": "Content Alignment",
            "type": "radio",
            "options": ["left", "center", "right"],
            "default": "center"
        },
        {
            "key": "min_height",
            "label": "Minimum Height (px)",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 1000
        },
        {
            "key": "padding_top",
            "label": "Padding Top (px)",
            "type": "range",
            "default": 40,
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom (px)",
            "type": "range",
            "default": 40,
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_left",
            "label": "Padding Left (px)",
            "type": "range",
            "default": 20,
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_right",
            "label": "Padding Right (px)",
            "type": "range",
            "default": 20,
            "min": 0,
            "max": 100
        },
        {
            "key": "show_on",
            "label": "Show Section On",
            "type": "radio",
            "options": ["desktop", "mobile", "both"],
            "default": "both"
        },
        {
            "key": "enable_border",
            "label": "Enable Border",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        },
        {
            "key": "enable_shadow",
            "label": "Enable Shadow",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "disable"
        }
    ]
}

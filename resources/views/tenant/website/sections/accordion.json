{
    "type": "accordion",
    "name": "Accordion / FAQ",
    "icon": "fa-list-ul",
    "order": 1,
    "category": "content",
    "color_scheme_id": 1,
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "accordion_style",
            "label": "Accordion Style",
            "type": "radio",
            "options": ["default", "bordered", "filled", "shadow"],
            "default": "default"
        },
        {
            "key": "icon_position",
            "label": "Icon Position",
            "type": "radio",
            "options": ["left", "right"],
            "default": "right"
        },
        {
            "key": "allow_multiple",
            "label": "Allow Multiple Open",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "no"
        },
        {
            "key": "first_open",
            "label": "First Item Open by Default",
            "type": "radio",
            "options": ["yes", "no"],
            "default": "yes"
        },
        {
            "key": "border_radius",
            "label": "Border Radius",
            "type": "radio",
            "options": ["enable", "disable"],
            "default": "enable"
        },
        {
            "key": "item_gap",
            "label": "Gap Between Items",
            "type": "range",
            "default": "12",
            "min": 0,
            "max": 50
        },
        {
            "key": "item_1_title",
            "label": "Item 1 - Title",
            "type": "text",
            "default": "What is your return policy?",
            "placeholder": "Enter question or title"
        },
        {
            "key": "item_1_content",
            "label": "Item 1 - Content",
            "type": "textarea",
            "default": "We offer a 30-day money-back guarantee on all products. Simply contact our support team to initiate a return.",
            "placeholder": "Enter answer or content"
        },

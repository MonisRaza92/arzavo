{
    "type": "social_icons",
    "name": "Social Icons",
    "icon": "fa-share-nodes",
    "order": 0,
    "category": "social",
    "color_scheme_id": 1,
    "max_blocks": 0,
    "allowed_blocks": "",
    "default_blocks": "",
    "fields": [
        {
            "key": "color_scheme_id",
            "label": "Color Scheme",
            "type": "color_scheme_selector"
        },
        {
            "key": "alignment",
            "label": "Alignment",
            "type": "radio",
            "options": ["start", "center", "end"],
            "default": "center"
        },
        {
            "key": "icon_size",
            "label": "Icon Size",
            "type": "select",
            "options": ["small", "medium", "large", "extra-large","huge","jumbo","gigantic"],
            "default": "medium"
        },
        {
            "key": "icon_style",
            "label": "Icon Style",
            "type": "select",
            "options": [
                "default",
                "filled",
                "outlined",
                "square",
                "square-outlined"
            ],
            "default": "default"
        },
        {
            "key": "gap",
            "label": "Gap Between Icons",
            "type": "range",
            "default": "16",
            "min": 0,
            "max": 100
        },
        {
            "key": "background_type",
            "label": "Background Type",
            "type": "radio",
            "options": ["none", "color", "image"],
            "default": "none"
        },
        {
            "key": "background_image",
            "label": "Background Image",
            "type": "image",
            "default": ""
        },
        {
            "key": "facebook_url",
            "label": "Facebook URL",
            "type": "text",
            "default": "",
            "placeholder": "https://facebook.com/yourpage"
        },
        {
            "key": "twitter_url",
            "label": "Twitter/X URL",
            "type": "text",
            "default": "",
            "placeholder": "https://twitter.com/yourhandle"
        },
        {
            "key": "instagram_url",
            "label": "Instagram URL",
            "type": "text",
            "default": "",
            "placeholder": "https://instagram.com/yourhandle"
        },
        {
            "key": "linkedin_url",
            "label": "LinkedIn URL",
            "type": "text",
            "default": "",
            "placeholder": "https://linkedin.com/in/yourprofile"
        },
        {
            "key": "youtube_url",
            "label": "YouTube URL",
            "type": "text",
            "default": "",
            "placeholder": "https://youtube.com/@yourchannel"
        },
        {
            "key": "pinterest_url",
            "label": "Pinterest URL",
            "type": "text",
            "default": "",
            "placeholder": "https://pinterest.com/yourprofile"
        },
        {
            "key": "tiktok_url",
            "label": "TikTok URL",
            "type": "text",
            "default": "",
            "placeholder": "https://tiktok.com/@yourhandle"
        },
        {
            "key": "whatsapp_url",
            "label": "WhatsApp URL",
            "type": "text",
            "default": "",
            "placeholder": "https://wa.me/1234567890"
        },
        {
            "key": "telegram_url",
            "label": "Telegram URL",
            "type": "text",
            "default": "",
            "placeholder": "https://t.me/yourusername"
        },
        {
            "key": "snapchat_url",
            "label": "Snapchat URL",
            "type": "text",
            "default": "",
            "placeholder": "https://snapchat.com/add/yourhandle"
        },
        {
            "key": "discord_url",
            "label": "Discord URL",
            "type": "text",
            "default": "",
            "placeholder": "https://discord.gg/yourinvite"
        },
        {
            "key": "github_url",
            "label": "GitHub URL",
            "type": "text",
            "default": "",
            "placeholder": "https://github.com/yourusername"
        },
        {
            "key": "padding_top",
            "label": "Padding Top",
            "type": "range",
            "default": "40",
            "min": 0,
            "max": 100
        },
        {
            "key": "padding_bottom",
            "label": "Padding Bottom",
            "type": "range",
            "default": "40",
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_top",
            "label": "Margin Top",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        },
        {
            "key": "margin_bottom",
            "label": "Margin Bottom",
            "type": "range",
            "default": "0",
            "min": 0,
            "max": 100
        }
    ]
}
